    "directory": "packages/monitoring",
    "type": "git",
    "url": "https://github.com/NextNodeSolutions/core.git"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev",
    "format": "oxfmt --write .",
