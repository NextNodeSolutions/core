---
import {
	DEPLOY_STATUS_COLOR,
	DEPLOY_STATUS_ICON,
} from '@/components/cloudflare/deploy-display.ts'
import DeploymentTail from '@/components/cloudflare/DeploymentTail.astro'
import Icon from '@/components/foundations/Icon.astro'
import type { IconName } from '@/components/foundations/Icon.astro'
import LoadStateBanner from '@/components/dashboard/LoadStateBanner.astro'
import { resolveCloudflareClient } from '@/lib/adapters/cloudflare/accounts.ts'
import { listPagesDeployments } from '@/lib/adapters/cloudflare/pages-deployments.ts'
import { listPagesProjects } from '@/lib/adapters/cloudflare/pages-projects.ts'
import { loadPageState } from '@/lib/adapters/load-page-state.ts'
import {
	deploymentDisplayStatus,
	deploymentPipelineSteps,
	selectRecentDeployments,
	summarizeProject,
} from '@/lib/domain/cloudflare/deployment-summary.ts'
import type {
	DeployDisplayStatus,
	PipelineStep,
	ProjectSummary,
	RecentDeployment,
	StepState,
} from '@/lib/domain/cloudflare/deployment-summary.ts'
import { cloudflareApiPath } from '@/lib/domain/cloudflare/pages-routes.ts'
import {
	formatDurationSeconds,
	formatRelative,
} from '@/lib/domain/monitoring/format.ts'

import type { CloudflareClient } from '@/lib/adapters/cloudflare/client.ts'
import type { CloudflarePagesDeployment } from '@/lib/domain/cloudflare/pages-deployment.ts'
import type { CloudflarePagesProject } from '@/lib/domain/cloudflare/pages-project.ts'

interface Props {
	project: string
	env: string
	sel: string
}

const PER_PROJECT_LIMIT = 20
const ACTIVITY_LIMIT = 8
const COMMIT_LENGTH = 7
const HIGH_SUCCESS_RATE = 90
const MID_SUCCESS_RATE = 70
const STRIP_BASE_OPACITY = 0.35
const STRIP_GRADED_RANGE = 0.65
const ALL_ENV = 'all'
const DEFAULT_ENV = 'all'

const { project, env, sel } = Astro.props

const clientState = await loadPageState(
	'deployments.client',
	resolveCloudflareClient,
)
const client = clientState.kind === 'ok' ? clientState.data : null

const loadProjects = async (
	resolved: CloudflareClient,
): Promise<ReadonlyArray<CloudflarePagesProject>> => {
	const state = await loadPageState('deployments.projects', () =>
		listPagesProjects({ client: resolved }),
	)
	return state.kind === 'ok' ? state.data : []
}

const projects: ReadonlyArray<CloudflarePagesProject> =
	client === null ? [] : await loadProjects(client)

const loadProjectDeployments = async (
	resolved: CloudflareClient,
): Promise<Record<string, ReadonlyArray<CloudflarePagesDeployment>>> => {
	const states = await Promise.all(
		projects.map(currentProject =>
			loadPageState(`deployments.deps.${currentProject.name}`, () =>
				listPagesDeployments({
					client: resolved,
					projectName: currentProject.name,
					limit: PER_PROJECT_LIMIT,
				}),
			),
		),
	)
	const grouped: Record<string, ReadonlyArray<CloudflarePagesDeployment>> = {}
	projects.forEach((currentProject, index) => {
		const state = states[index]
		grouped[currentProject.name] =
			state !== undefined && state.kind === 'ok' ? state.data : []
	})
	return grouped
}

const deploymentsByProject: Record<
	string,
	ReadonlyArray<CloudflarePagesDeployment>
> = client === null ? {} : await loadProjectDeployments(client)

const selectedProject = projects.find(entry => entry.name === project) ?? null

const allEntries: ReadonlyArray<RecentDeployment> = projects.flatMap(
	currentProject =>
		(deploymentsByProject[currentProject.name] ?? []).map(deployment => ({
			projectName: currentProject.name,
			deployment,
		})),
)
const recent = selectRecentDeployments(allEntries, ACTIVITY_LIMIT)

const selectedEntry =
	allEntries.find(entry => entry.deployment.id === sel) ?? null
const selectedDeployment = selectedEntry?.deployment ?? null

const nowMs = Date.now()

const linkTo = (overrides: Record<string, string | null>): string => {
	const params = new URLSearchParams()
	if (project) params.set('project', project)
	if (env !== DEFAULT_ENV) params.set('env', env)
	if (sel) params.set('sel', sel)
	for (const [key, override] of Object.entries(overrides)) {
		if (override === null) params.delete(key)
		else params.set(key, override)
	}
	const qs = params.toString()
	return qs ? `/deployments?${qs}` : '/deployments'
}

const statusBadgeClass: Record<DeployDisplayStatus, string> = {
	ready: 'border-emerald-200 bg-emerald-50 text-emerald-700',
	building: 'border-sky-200 bg-sky-50 text-sky-700',
	error: 'border-red-200 bg-red-50 text-red-700',
	idle: 'border-base-200 bg-base-100 text-base-600',
}
const statusLabel: Record<DeployDisplayStatus, string> = {
	ready: 'prêt',
	building: 'build',
	error: 'échec',
	idle: 'idle',
}
const stripBg: Record<DeployDisplayStatus, string> = {
	ready: 'bg-emerald-600',
	building: 'bg-sky-600',
	error: 'bg-red-600',
	idle: 'bg-base-400',
}
const stepDotClass: Record<StepState, string> = {
	done: 'bg-emerald-600 text-white',
	active: 'bg-sky-600 text-white',
	failed: 'bg-red-600 text-white',
	pending: 'bg-base-200 text-base-400',
}
const stepLabelClass: Record<StepState, string> = {
	done: 'font-semibold text-base-900',
	active: 'font-semibold text-base-900',
	failed: 'font-semibold text-red-600',
	pending: 'font-medium text-base-500',
}

const EMPTY_VALUE = '-'

const successRateClass = (rate: number | null): string => {
	if (rate === null) return 'text-base-400'
	if (rate >= HIGH_SUCCESS_RATE) return 'text-emerald-600'
	if (rate >= MID_SUCCESS_RATE) return 'text-amber-600'
	return 'text-red-600'
}

const successRateLabel = (rate: number | null): string =>
	rate === null ? EMPTY_VALUE : `${rate}%`

const commitLabel = (deployment: CloudflarePagesDeployment): string =>
	deployment.commitHash?.slice(0, COMMIT_LENGTH) ?? deployment.shortId

const durationLabel = (deployment: CloudflarePagesDeployment): string =>
	formatDurationSeconds(
		Date.parse(deployment.modifiedAt) - Date.parse(deployment.createdAt),
	)

const stripOpacity = (index: number, count: number): number =>
	STRIP_BASE_OPACITY + (STRIP_GRADED_RANGE * (count - index)) / count

interface ProjectView {
	readonly project: CloudflarePagesProject
	readonly summary: ProjectSummary
	readonly currentDisplay: DeployDisplayStatus
}

const projectViews: ReadonlyArray<ProjectView> = projects.map(currentProject => {
	const summary = summarizeProject(
		deploymentsByProject[currentProject.name] ?? [],
	)
	return {
		project: currentProject,
		summary,
		currentDisplay: deploymentDisplayStatus(
			summary.current?.status ?? 'unknown',
		),
	}
})

const stepDotIcon = (state: StepState): IconName | null => {
	if (state === 'done') return 'check'
	if (state === 'active') return 'refresh'
	if (state === 'failed') return 'x'
	return null
}

const detailDeployments: ReadonlyArray<CloudflarePagesDeployment> =
	selectedProject ? (deploymentsByProject[selectedProject.name] ?? []) : []
const detailSummary = selectedProject ? summarizeProject(detailDeployments) : null
const detailCurrent = detailSummary?.current ?? null
const detailDisplay = deploymentDisplayStatus(detailCurrent?.status ?? 'unknown')
const historyDeployments = detailDeployments.filter(
	deployment => env === ALL_ENV || deployment.environment === env,
)

const envOptions: ReadonlyArray<{ key: string; label: string }> = [
	{ key: 'all', label: 'Tous' },
	{ key: 'production', label: 'Production' },
	{ key: 'preview', label: 'Preview' },
]

const drawerDisplay = selectedDeployment
	? deploymentDisplayStatus(selectedDeployment.status)
	: 'idle'
const drawerSteps: ReadonlyArray<PipelineStep> = selectedDeployment
	? deploymentPipelineSteps(selectedDeployment.status)
	: []
const drawerProjectName = selectedEntry?.projectName ?? ''
const drawerSpecs: ReadonlyArray<{ label: string; text: string }> =
	selectedDeployment
		? [
				{ label: 'Projet', text: drawerProjectName },
				{ label: 'Auteur', text: selectedDeployment.author ?? '-' },
				{ label: 'Durée', text: durationLabel(selectedDeployment) },
				{
					label: 'Démarré',
					text: formatRelative(
						Date.parse(selectedDeployment.createdAt),
						nowMs,
					),
				},
			]
		: []

const clientFailed = clientState.kind !== 'ok'
---

{
	clientFailed ? (
		<div class="px-6">
			<LoadStateBanner state={clientState} upstreamLabel="Cloudflare API error" />
		</div>
	) : (
		<div class="flex h-full min-h-0">
			<div class="min-w-0 flex-1 overflow-auto">
				{selectedProject === null ? (
					<div class="p-6">
						<div class="mb-4 flex flex-wrap items-center justify-between gap-2.5">
							<span class="inline-flex items-center gap-2 font-mono text-[11px] font-semibold tracking-[0.12em] text-base-700 uppercase">
								<span class="size-2.5 rounded-[2px] bg-base-900" />
								Cloudflare Pages · {projects.length} projets
							</span>
							<span class="text-xs text-base-500">
								Sélectionnez un projet pour voir ses déploiements
							</span>
						</div>

						<div class="grid grid-cols-[repeat(auto-fill,minmax(320px,1fr))] gap-4">
							{projectViews.map(view => (
								<a
									href={linkTo({
										project: view.project.name,
										env: null,
										sel: null,
									})}
									class="flex flex-col overflow-hidden rounded-xl border border-base-200 bg-white shadow-subtle transition-shadow hover:shadow-md"
								>
									<div class="flex items-start justify-between gap-2.5 px-4.5 pt-4">
										<div class="min-w-0">
											<div class="flex items-center gap-2">
												<span class={DEPLOY_STATUS_COLOR[view.currentDisplay]}>
													<Icon name={DEPLOY_STATUS_ICON[view.currentDisplay]} size={15} />
												</span>
												<span class="text-[15px] font-semibold text-base-900">
													{view.project.name}
												</span>
											</div>
											<span class="mt-1 inline-flex items-center gap-1 font-mono text-xs text-base-400">
												{view.project.subdomain}
												<Icon name="external" size={11} />
											</span>
										</div>
									</div>

									<div class="flex items-center gap-5 px-4.5 pt-3 pb-3.5">
										<div>
											<div class="text-[10.5px] text-base-400">Production</div>
											<span
												class:list={[
													'mt-1 inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] font-semibold uppercase',
													statusBadgeClass[view.currentDisplay],
												]}
											>
												{statusLabel[view.currentDisplay]}
											</span>
										</div>
										<div>
											<div class="text-[10.5px] text-base-400">Succès</div>
											<div
												class:list={[
													'mt-1 font-mono text-sm font-bold',
													successRateClass(view.summary.successRate),
												]}
											>
												{successRateLabel(view.summary.successRate)}
											</div>
										</div>
										<div class="ml-auto text-right">
											<div class="text-[10.5px] text-base-400">5 derniers</div>
											<div class="mt-1.5 flex gap-1">
												{view.summary.lastStatuses.map((status, index) => (
													<span
														class:list={[
															'h-[18px] w-[7px] rounded-[3px]',
															stripBg[status],
														]}
														style={`opacity:${stripOpacity(index, view.summary.lastStatuses.length).toFixed(2)}`}
													/>
												))}
											</div>
										</div>
									</div>

									<div class="flex items-center justify-between border-t border-base-100 bg-base-50 px-4.5 py-2.5">
										<span class="flex min-w-0 items-center gap-1.5 overflow-hidden font-mono text-[11.5px] text-base-500">
											<Icon name="branch" size={11} />
											<span class="truncate">
												{view.summary.last
													? `${commitLabel(view.summary.last)} · ${formatRelative(Date.parse(view.summary.last.createdAt), nowMs)}`
													: 'aucun déploiement'}
											</span>
										</span>
										<span class="flex flex-none gap-2.5 font-mono text-[11px] text-base-500">
											<span>{view.summary.prodCount} prod</span>
											<span>{view.summary.previewCount} preview</span>
										</span>
									</div>
								</a>
							))}
						</div>

						<div class="mt-6 mb-3">
							<span class="inline-flex items-center gap-2 font-mono text-[11px] font-semibold tracking-[0.12em] text-base-700 uppercase">
								<span class="size-2.5 rounded-[2px] bg-base-900" />
								Activité récente · tous projets
							</span>
						</div>
						<div class="overflow-hidden rounded-xl border border-base-200 bg-white shadow-subtle">
							{recent.length === 0 ? (
								<div class="px-4 py-12 text-center text-sm text-base-400">
									Aucun déploiement récent.
								</div>
							) : (
								recent.map(entry => {
									const display = deploymentDisplayStatus(
										entry.deployment.status,
									)
									return (
										<a
											href={linkTo({
												project: entry.projectName,
												sel: entry.deployment.id,
											})}
											class="flex items-center gap-3.5 border-b border-base-100 px-4 py-2.5 last:border-b-0 hover:bg-base-50"
										>
											<span class={`flex-none ${DEPLOY_STATUS_COLOR[display]}`}>
												<Icon name={DEPLOY_STATUS_ICON[display]} size={15} />
											</span>
											<div class="min-w-0 flex-1">
												<div class="truncate text-[13.5px] font-medium text-base-900">
													{entry.deployment.commitMessage ?? entry.deployment.shortId}
												</div>
												<div class="font-mono text-[11px] text-base-500">
													{commitLabel(entry.deployment)}
												</div>
											</div>
											<span class="flex-none rounded-full border border-base-200 bg-base-100 px-2 py-0.5 font-mono text-[11px] text-base-700">
												{entry.projectName}
											</span>
											<span
												class:list={[
													'flex-none rounded-full border px-2 py-0.5 text-[11px] font-medium',
													entry.deployment.environment === 'production'
														? 'border-accent-200 bg-accent-50 text-accent-700'
														: 'border-base-200 bg-base-100 text-base-600',
												]}
											>
												{entry.deployment.environment === 'production'
													? 'prod'
													: 'preview'}
											</span>
											<span class="flex-none font-mono text-xs whitespace-nowrap text-base-500">
												{formatRelative(
													Date.parse(entry.deployment.createdAt),
													nowMs,
												)}
											</span>
										</a>
									)
								})
							)}
						</div>
					</div>
				) : (
					<div class="p-6">
						<a
							href={linkTo({ project: null, env: null, sel: null })}
							class="mb-3.5 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium text-base-700 hover:bg-base-100"
						>
							<span class="rotate-180">
								<Icon name="chevron" size={14} />
							</span>
							Tous les projets
						</a>

						<div class="mb-4 overflow-hidden rounded-xl border border-base-200 bg-white shadow-subtle">
							<div class="flex flex-wrap items-center gap-4 px-5 py-4">
								<div class="min-w-[220px] flex-1">
									<div class="flex flex-wrap items-center gap-2.5">
										<span class={DEPLOY_STATUS_COLOR[detailDisplay]}>
											<Icon name={DEPLOY_STATUS_ICON[detailDisplay]} size={16} />
										</span>
										<span class="text-lg font-bold text-base-900">
											{selectedProject.name}
										</span>
										<span
											class:list={[
												'inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-semibold uppercase',
												statusBadgeClass[detailDisplay],
											]}
										>
											{statusLabel[detailDisplay]}
										</span>
									</div>
									<span class="mt-1.5 inline-flex items-center gap-1.5 font-mono text-[13px] text-accent-700">
										{selectedProject.subdomain}
										<Icon name="external" size={12} />
									</span>
								</div>
								<div class="flex flex-wrap gap-2">
									<a
										href={`https://${selectedProject.subdomain}`}
										target="_blank"
										rel="noreferrer"
										class="inline-flex items-center gap-1.5 rounded-full border border-base-200 bg-white px-3.5 py-1.5 text-xs font-medium text-base-800 hover:bg-base-50"
									>
										<Icon name="external" size={14} />
										Visiter
									</a>
								</div>
							</div>
							<div class="grid grid-cols-[repeat(auto-fit,minmax(130px,1fr))] gap-4 border-t border-base-100 bg-base-50 px-5 py-3.5">
								<div>
									<div class="text-[11px] text-base-400">Déploiement prod</div>
									<div class="mt-0.5 font-mono text-[13px] text-base-900">
										{detailCurrent ? commitLabel(detailCurrent) : '-'}
									</div>
								</div>
								<div>
									<div class="text-[11px] text-base-400">Branche prod</div>
									<div class="mt-0.5 font-mono text-[13px] text-base-900">
										{selectedProject.productionBranch}
									</div>
								</div>
								<div>
									<div class="text-[11px] text-base-400">Dernier deploy</div>
									<div class="mt-0.5 text-[13px] text-base-900">
										{detailCurrent
											? formatRelative(
													Date.parse(detailCurrent.createdAt),
													nowMs,
												)
											: '-'}
									</div>
								</div>
								<div>
									<div class="text-[11px] text-base-400">Taux de succès</div>
									<div class="mt-0.5 font-mono text-[13px] text-base-900">
										{successRateLabel(detailSummary?.successRate ?? null)}
									</div>
								</div>
								<div>
									<div class="text-[11px] text-base-400">Déploiements</div>
									<div class="mt-0.5 text-[13px] text-base-900">
										{detailSummary?.prodCount ?? 0} prod ·{' '}
										{detailSummary?.previewCount ?? 0} preview
									</div>
								</div>
							</div>
						</div>

						<div class="mb-3 flex flex-wrap items-center justify-between gap-2.5">
							<span class="text-sm font-semibold text-base-900">
								Historique des déploiements
							</span>
							<div class="inline-flex rounded-full border border-base-200 bg-white p-0.5">
								{envOptions.map(option => (
									<a
										href={linkTo({
											env: option.key === ALL_ENV ? null : option.key,
											sel: null,
										})}
										class:list={[
											'rounded-full px-3 py-1 text-xs font-medium',
											env === option.key
												? 'bg-base-900 text-white'
												: 'text-base-600 hover:bg-base-50',
										]}
									>
										{option.label}
									</a>
								))}
							</div>
						</div>

						<div class="overflow-hidden rounded-xl border border-base-200 bg-white shadow-subtle">
							<div class="overflow-x-auto">
								<table class="w-full min-w-[620px] text-left text-sm">
									<thead>
										<tr class="border-b border-base-100 font-mono text-[10px] tracking-[0.04em] text-base-400 uppercase">
											<th class="w-8 px-4 py-2" />
											<th class="px-2 py-2">Déploiement</th>
											<th class="px-2 py-2">Branche</th>
											<th class="px-2 py-2">Env</th>
											<th class="px-2 py-2">Durée</th>
											<th class="px-4 py-2 text-right">Quand</th>
										</tr>
									</thead>
									<tbody>
										{historyDeployments.length === 0 ? (
											<tr>
												<td
													colspan="6"
													class="px-4 py-12 text-center text-base-400"
												>
													Aucun déploiement pour ce filtre.
												</td>
											</tr>
										) : (
											historyDeployments.map(deployment => {
												const display = deploymentDisplayStatus(
													deployment.status,
												)
												const active = deployment.id === sel
												return (
													<tr
														class:list={[
															'border-b border-base-100 last:border-b-0',
															active ? 'bg-base-50' : 'hover:bg-base-50',
														]}
													>
														<td class="px-4 py-2.5">
															<a
																href={linkTo({ sel: deployment.id })}
																class={`block ${DEPLOY_STATUS_COLOR[display]}`}
															>
																<Icon
																	name={DEPLOY_STATUS_ICON[display]}
																	size={15}
																/>
															</a>
														</td>
														<td class="px-2 py-2.5">
															<a
																href={linkTo({ sel: deployment.id })}
																class="block"
															>
																<div class="max-w-[300px] truncate font-medium text-base-900">
																	{deployment.commitMessage ?? deployment.shortId}
																</div>
																<div class="font-mono text-[11px] text-base-500">
																	{deployment.shortId} ·{' '}
																	{deployment.author ?? 'inconnu'}
																</div>
															</a>
														</td>
														<td class="px-2 py-2.5">
															<span class="inline-flex items-center gap-1.5 font-mono text-[12.5px] text-base-700">
																<Icon name="branch" size={11} />
																{deployment.branch ?? '-'}
															</span>
															<div class="font-mono text-[11px] text-base-500">
																{commitLabel(deployment)}
															</div>
														</td>
														<td class="px-2 py-2.5">
															<span
																class:list={[
																	'inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium',
																	deployment.environment === 'production'
																		? 'border-accent-200 bg-accent-50 text-accent-700'
																		: 'border-base-200 bg-base-100 text-base-600',
																]}
															>
																{deployment.environment === 'production'
																	? 'prod'
																	: 'preview'}
															</span>
														</td>
														<td class="px-2 py-2.5 font-mono text-[12.5px] text-base-500">
															{durationLabel(deployment)}
														</td>
														<td class="px-4 py-2.5 text-right font-mono text-xs whitespace-nowrap text-base-500">
															{formatRelative(
																Date.parse(deployment.createdAt),
																nowMs,
															)}
														</td>
													</tr>
												)
											})
										)}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				)}
			</div>

			{selectedDeployment && (
				<div class="flex w-[440px] flex-none flex-col overflow-auto border-l border-base-200 bg-white">
					<div class="sticky top-0 z-2 flex items-center justify-between border-b border-base-200 bg-white px-4.5 py-3.5">
						<div class="flex min-w-0 items-center gap-2.5">
							<span class={`flex-none ${DEPLOY_STATUS_COLOR[drawerDisplay]}`}>
								<Icon name={DEPLOY_STATUS_ICON[drawerDisplay]} size={16} />
							</span>
							<span class="truncate font-mono text-sm font-bold text-base-900">
								{selectedDeployment.shortId}
							</span>
							<span
								class:list={[
									'flex-none rounded-full border px-2 py-0.5 text-[11px] font-semibold uppercase',
									statusBadgeClass[drawerDisplay],
								]}
							>
								{statusLabel[drawerDisplay]}
							</span>
						</div>
						<a
							href={linkTo({ sel: null })}
							class="rounded-full p-1 text-base-500 hover:bg-base-50 hover:text-base-900"
							aria-label="Fermer le détail"
						>
							<Icon name="x" size={16} />
						</a>
					</div>

					<div class="flex flex-col gap-4 p-4.5">
						<div>
							<div class="mb-2 text-[15px] font-semibold text-base-900">
								{selectedDeployment.commitMessage ?? selectedDeployment.shortId}
							</div>
							<div class="flex flex-wrap gap-2">
								<span
									class:list={[
										'inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-medium',
										selectedDeployment.environment === 'production'
											? 'border-accent-200 bg-accent-50 text-accent-700'
											: 'border-base-200 bg-base-100 text-base-600',
									]}
								>
									{selectedDeployment.environment}
								</span>
								<span class="inline-flex items-center gap-1.5 rounded-full border border-base-200 bg-base-100 px-2.5 py-0.5 font-mono text-[11px] text-base-700">
									<Icon name="branch" size={11} />
									{selectedDeployment.branch ?? '-'}
								</span>
								<span class="inline-flex items-center rounded-full border border-base-200 bg-base-100 px-2.5 py-0.5 font-mono text-[11px] text-base-700">
									{commitLabel(selectedDeployment)}
								</span>
							</div>
						</div>

						<div class="grid grid-cols-2 gap-3">
							{drawerSpecs.map(spec => (
								<div>
									<div class="text-[11px] text-base-400">{spec.label}</div>
									<div class="mt-0.5 text-[13px] text-base-900">{spec.text}</div>
								</div>
							))}
						</div>

						{selectedDeployment.url !== null && (
							<div>
								<div class="mb-1 text-[11px] text-base-400">URL</div>
								<a
									href={`https://${selectedDeployment.url}`}
									target="_blank"
									rel="noreferrer"
									class="font-mono text-[12.5px] break-all text-accent-700 hover:underline"
								>
									{selectedDeployment.url}
								</a>
							</div>
						)}

						<div>
							<div class="mb-2 text-[11px] text-base-400">Pipeline</div>
							<div class="flex flex-col">
								{drawerSteps.map(step => (
									<div class="flex items-center gap-3 py-1.5">
										<span
											class:list={[
												'grid size-[18px] flex-none place-items-center rounded-full',
												stepDotClass[step.state],
											]}
										>
											{stepDotIcon(step.state) === null ? (
												<span class="size-[5px] rounded-full bg-current" />
											) : (
												<Icon name={stepDotIcon(step.state) ?? 'dot'} size={11} />
											)}
										</span>
										<span class={`text-[13px] ${stepLabelClass[step.state]}`}>
											{step.label}
										</span>
									</div>
								))}
							</div>
						</div>

						<div>
							<div class="mb-2 flex items-center gap-1.5 text-[11px] text-base-400">
								<Icon name="logs" size={12} />
								Build logs
							</div>
							{drawerDisplay === 'building' ? (
								<DeploymentTail
									projectName={drawerProjectName}
									deployment={selectedDeployment}
								/>
							) : (
								<div class="rounded-lg border border-base-200 bg-base-50 px-3 py-2.5 text-xs text-base-500">
									Build logs disponibles en direct pendant le build uniquement.
								</div>
							)}
						</div>

						<div class="flex gap-2">
							{drawerDisplay === 'error' && (
								<form
									method="post"
									action={cloudflareApiPath(
										drawerProjectName,
										'deployments',
										selectedDeployment.id,
										'retry',
									)}
									class="flex-1"
								>
									<button
										type="submit"
										class="inline-flex w-full items-center justify-center gap-1.5 rounded-full bg-accent-600 px-3.5 py-1.5 text-xs font-medium text-white hover:bg-accent-700"
									>
										<Icon name="refresh" size={14} />
										Re-deploy
									</button>
								</form>
							)}
							{drawerDisplay === 'ready' &&
								selectedDeployment.environment === 'production' && (
									<form
										method="post"
										action={cloudflareApiPath(
											drawerProjectName,
											'deployments',
											selectedDeployment.id,
											'rollback',
										)}
										class="flex-1"
									>
										<button
											type="submit"
											class="inline-flex w-full items-center justify-center gap-1.5 rounded-full bg-base-50 px-3.5 py-1.5 text-xs font-medium text-base-800 hover:bg-base-100"
										>
											<Icon name="refresh" size={14} />
											Rollback
										</button>
									</form>
								)}
							{selectedDeployment.url !== null && (
								<a
									href={`https://${selectedDeployment.url}`}
									target="_blank"
									rel="noreferrer"
									class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-full border border-base-200 bg-white px-3.5 py-1.5 text-xs font-medium text-base-800 hover:bg-base-50"
								>
									<Icon name="external" size={14} />
									Visiter
								</a>
							)}
						</div>
					</div>
				</div>
			)}
		</div>
	)
}
