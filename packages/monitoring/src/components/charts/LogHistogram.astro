---
import { histogramBars } from '@/lib/domain/monitoring/log-explorer.ts'
import type { LogBucket } from '@/lib/domain/monitoring/log-explorer.ts'
import type { LogLevel } from '@/lib/domain/monitoring/log-query.ts'

interface Props {
	buckets: ReadonlyArray<LogBucket>
	height?: number
}

const VIEW_WIDTH = 600
const DEFAULT_HEIGHT = 56

const { buckets, height = DEFAULT_HEIGHT } = Astro.props

const bars = histogramBars(buckets, { width: VIEW_WIDTH, height })

const levelFill: Record<LogLevel, string> = {
	debug: 'fill-base-400',
	info: 'fill-sky-600',
	warn: 'fill-amber-500',
	error: 'fill-red-600',
}
---

<svg
	viewBox={`0 0 ${VIEW_WIDTH} ${height}`}
	width="100%"
	height={height}
	preserveAspectRatio="none"
	class="block"
	role="img"
	aria-label="Volume de logs par niveau"
>
	{
		bars.map((bar) =>
			bar.segments.map((segment) => (
				<rect
					x={bar.x}
					y={segment.y}
					width={bar.width}
					height={segment.height}
					rx="1"
					class:list={[levelFill[segment.level]]}
				/>
			)),
		)
	}
</svg>
