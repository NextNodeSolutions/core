---
import Icon from '@/components/foundations/Icon.astro'
import LoadStateBanner from '@/components/dashboard/LoadStateBanner.astro'
import { loadGithubProjects } from '@/lib/adapters/github/projects.ts'
import { loadPageState } from '@/lib/adapters/load-page-state.ts'
import { listFleetVps } from '@/lib/adapters/victoria/fleet.ts'
import { escapeRegex } from '@/lib/domain/escape-regex.ts'
import {
	canApprove,
	canDeploy,
	canTeardown,
} from '@/lib/domain/github/github-project.ts'
import { formatRelative } from '@/lib/domain/monitoring/format.ts'

import type { ProjectDeployStatus } from '@/lib/domain/github/github-project.ts'

interface StatusStyle {
	readonly badgeClass: string
	readonly label: string
}

const SQUARE_SIZE = 38
const ICON_SIZE = 19
const BADGE_ICON_SIZE = 11
const ACTION_ICON_SIZE = 14

const statusStyles: Record<ProjectDeployStatus, StatusStyle> = {
	ready: {
		badgeClass: 'border-emerald-200 bg-emerald-50 text-emerald-700',
		label: 'ready',
	},
	building: {
		badgeClass: 'border-sky-200 bg-sky-50 text-sky-700',
		label: 'building',
	},
	error: { badgeClass: 'border-red-200 bg-red-50 text-red-700', label: 'error' },
	queued: {
		badgeClass: 'border-amber-200 bg-amber-50 text-amber-700',
		label: 'queued',
	},
	archived: {
		badgeClass: 'border-base-200 bg-base-100 text-base-600',
		label: 'archived',
	},
	unknown: {
		badgeClass: 'border-base-200 bg-base-100 text-base-600',
		label: 'unknown',
	},
}

const serversState = await loadPageState('projects.servers', () =>
	listFleetVps(),
)
const serverNames =
	serversState.kind === 'ok'
		? serversState.data.map(server => server.name)
		: []

const projectsState = await loadPageState('projects.github', () =>
	loadGithubProjects(serverNames),
)
const projects = projectsState.kind === 'ok' ? projectsState.data : []

const nowMs = Date.now()
---

<div class="flex flex-col gap-5">
	<div class="flex items-center justify-between">
		<span
			class="inline-flex items-center gap-2 font-mono text-[11px] font-semibold tracking-[0.12em] text-base-700 uppercase"
		>
			<span class="size-2.5 rounded-[2px] bg-base-900"></span>
			Projets GitHub · NextNodeSolutions
		</span>
		<a
			href="https://github.com/NextNodeSolutions"
			target="_blank"
			rel="noreferrer"
			class="inline-flex items-center gap-1.5 rounded-full bg-base-50 px-3.5 py-1.5 text-xs font-medium text-base-800 hover:bg-base-100"
		>
			<Icon name="github" size={ACTION_ICON_SIZE} />
			Organisation
		</a>
	</div>

	{
		projects.length === 0 ? (
			<LoadStateBanner state={projectsState} upstreamLabel="GitHub API error" />
		) : (
			<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-4">
				{projects.map(project => {
					const status = statusStyles[project.deployStatus]
					const lastDeploy =
						project.lastDeployAt === null
							? '-'
							: formatRelative(Date.parse(project.lastDeployAt), nowMs)
					return (
						<div class="flex flex-col overflow-hidden rounded-xl border border-base-200 bg-white shadow-subtle transition-shadow hover:shadow-md">
							<div class="flex items-start justify-between gap-3 px-4.5 pt-4">
								<div class="flex gap-3">
									<span
										class="grid flex-none place-items-center rounded-[10px] bg-base-900 text-white"
										style={`width:${SQUARE_SIZE}px;height:${SQUARE_SIZE}px`}
									>
										<Icon name="github" size={ICON_SIZE} />
									</span>
									<div class="min-w-0">
										<div class="flex items-center gap-2">
											<span class="text-[15px] font-semibold text-base-900">
												{project.name}
											</span>
											{project.isPrivate && (
												<span class="inline-flex items-center gap-1 rounded-full border border-base-200 bg-base-100 px-2 py-0.5 text-[10.5px] font-medium text-base-600">
													<Icon name="shield" size={BADGE_ICON_SIZE} />
													private
												</span>
											)}
										</div>
										<div class="mt-0.5 font-mono text-[11.5px] text-base-400">
											{project.repo}
										</div>
									</div>
								</div>
								<span
									class:list={[
										'inline-flex flex-none items-center rounded-full border px-2 py-0.5 text-[11px] font-semibold uppercase',
										status.badgeClass,
									]}
								>
									{status.label}
								</span>
							</div>

							{project.description !== null && (
								<div class="px-4.5 pt-3 text-[12.5px] leading-relaxed text-base-600">
									{project.description}
								</div>
							)}

							<div class="mt-3.5 grid grid-cols-2 gap-x-3.5 gap-y-2.5 border-t border-base-100 bg-base-50 px-4.5 py-3.5">
								<div>
									<div class="text-[10.5px] text-base-400">Branche</div>
									<div class="mt-0.5 font-mono text-[13px] text-base-900">
										{project.defaultBranch}
									</div>
								</div>
								<div>
									<div class="text-[10.5px] text-base-400">Dernier deploy</div>
									<div class="mt-0.5 text-[13px] text-base-900">{lastDeploy}</div>
								</div>
								<div>
									<div class="text-[10.5px] text-base-400">Commit</div>
									<div class="mt-0.5 font-mono text-[13px] text-base-900">
										{project.lastCommit ?? '-'}
									</div>
								</div>
								<div>
									<div class="text-[10.5px] text-base-400">VPS</div>
									<div class="mt-0.5 font-mono text-[13px] text-base-900">
										{project.vps ?? '-'}
									</div>
								</div>
							</div>

							{project.pendingApproval && (
								<div class="flex items-center gap-2.5 border-t border-amber-200 bg-amber-50 px-4.5 py-3 text-amber-800">
									<span class="flex-none text-amber-600">
										<Icon name="clock" size={15} />
									</span>
									<span class="text-[12.5px] font-medium">
										Déploiement prod en attente d'approbation
									</span>
								</div>
							)}

							<div class="flex flex-wrap items-center gap-2 border-t border-base-100 px-4.5 py-3">
								{canDeploy(project) && (
									<details class="relative">
										<summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-full bg-accent-600 px-3.5 py-1.5 text-xs font-medium text-white hover:bg-accent-700">
											<Icon name="rocket" size={ACTION_ICON_SIZE} />
											Déployer
										</summary>
										<div class="mt-2 w-[320px] rounded-xl border border-base-200 bg-white p-3.5 shadow-md">
											<p class="text-[12.5px] leading-relaxed text-base-700">
												Dispatch du workflow deploy.yml sur{' '}
												<span class="font-mono font-semibold text-base-900">
													{project.repo}
												</span>{' '}
												(branche{' '}
												<span class="font-mono font-semibold text-base-900">
													{project.defaultBranch}
												</span>
												)
											</p>
											<form
												method="post"
												action={`/api/projects/${project.slug}/workflows/dispatch`}
												class="mt-3"
											>
												<button
													type="submit"
													class="inline-flex w-full items-center justify-center gap-1.5 rounded-full bg-accent-600 px-3.5 py-1.5 text-xs font-medium text-white hover:bg-accent-700"
												>
													Confirmer le déploiement
												</button>
											</form>
										</div>
									</details>
								)}

								{canApprove(project) && (
									<details class="relative">
										<summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-base-200 bg-white px-3.5 py-1.5 text-xs font-medium text-base-800 hover:bg-base-50">
											<Icon name="check" size={ACTION_ICON_SIZE} />
											Approuver
										</summary>
										<div class="mt-2 w-[320px] rounded-xl border border-base-200 bg-white p-3.5 shadow-md">
											<p class="text-[12.5px] leading-relaxed text-base-700">
												Approuver l'environnement{' '}
												<span class="font-mono font-semibold text-base-900">
													production
												</span>{' '}
												en attente pour{' '}
												<span class="font-mono font-semibold text-base-900">
													{project.name}
												</span>
												.
											</p>
											<form
												method="post"
												action={`/api/projects/${project.slug}/deploy/approve`}
												class="mt-3"
											>
												<button
													type="submit"
													class="inline-flex w-full items-center justify-center gap-1.5 rounded-full bg-base-900 px-3.5 py-1.5 text-xs font-medium text-white hover:bg-base-800"
												>
													Approuver prod
												</button>
											</form>
										</div>
									</details>
								)}

								<div class="flex-1"></div>

								{project.vps !== null && (
									<a
										href={`/logs?vps=${encodeURIComponent(project.vps)}`}
										title="Logs"
										class="inline-flex items-center gap-1.5 rounded-full border border-base-200 bg-white px-3 py-1.5 text-xs font-medium text-base-700 hover:bg-base-50"
									>
										<Icon name="logs" size={ACTION_ICON_SIZE} />
									</a>
								)}

								<a
									href={project.htmlUrl}
									target="_blank"
									rel="noreferrer"
									title="GitHub"
									class="inline-flex items-center gap-1.5 rounded-full border border-base-200 bg-white px-3 py-1.5 text-xs font-medium text-base-700 hover:bg-base-50"
								>
									<Icon name="external" size={ACTION_ICON_SIZE} />
								</a>

								{canTeardown(project) && project.vps !== null && (
									<details class="relative">
										<summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-red-200 bg-red-50 px-3.5 py-1.5 text-xs font-medium text-red-700 hover:bg-red-100">
											<Icon name="trash" size={ACTION_ICON_SIZE} />
											Teardown
										</summary>
										<div class="mt-2 w-[320px] rounded-xl border border-red-200 bg-red-50 p-3.5 shadow-md">
											<p class="text-[12.5px] leading-relaxed text-red-800">
												Détruit le VPS Hetzner{' '}
												<span class="font-mono font-semibold text-red-900">
													{project.vps}
												</span>{' '}
												et tous ses volumes. Irréversible.
											</p>
											<form
												method="post"
												action={`/api/projects/${project.slug}/teardown`}
												class="mt-3 flex flex-col gap-2"
											>
												<input
													name="confirm"
													required
													pattern={escapeRegex(project.vps)}
													placeholder={`Tapez ${project.vps}`}
													autocomplete="off"
													class="rounded-lg border border-red-200 bg-white px-3 py-1.5 font-mono text-xs text-red-900 placeholder:text-red-300 focus:border-red-400 focus:outline-none"
												/>
												<button
													type="submit"
													class="inline-flex w-full items-center justify-center gap-1.5 rounded-full bg-red-600 px-3.5 py-1.5 text-xs font-medium text-white hover:bg-red-700"
												>
													Détruire le VPS
												</button>
											</form>
										</div>
									</details>
								)}
							</div>
						</div>
					)
				})}
			</div>
		)
	}
</div>
