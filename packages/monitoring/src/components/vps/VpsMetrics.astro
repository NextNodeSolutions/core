---
import AlertRow from '@/components/dashboard/AlertRow.astro'
import MultiLine from '@/components/charts/MultiLine.astro'
import Icon from '@/components/foundations/Icon.astro'
import RadialGauge from '@/components/charts/RadialGauge.astro'
import VpsMetricPanel from '@/components/vps/VpsMetricPanel.astro'
import { FleetComparison } from '@/islands/fleet-cmp/FleetComparison.tsx'
import { loadPageState } from '@/lib/adapters/load-page-state.ts'
import { mapWithConcurrency } from '@/lib/domain/concurrency.ts'
import {
	listFleetVps,
	loadTrafficTotals,
} from '@/lib/adapters/victoria/fleet.ts'
import {
	loadHostMetrics,
	loadVpsGauges,
	loadVpsSeries,
} from '@/lib/adapters/victoria/metrics.ts'
import { deriveFleetAlerts } from '@/lib/domain/monitoring/fleet-overview.ts'
import {
	bytesToWholeDecimalGb,
	bytesToWholeGb,
	NULL_TRAFFIC_TOTALS,
} from '@/lib/domain/monitoring/host-facts.ts'
import {
	EMPTY_LABEL,
	formatFixedOrDash,
	formatPercentOrDash,
	formatRoundedOrDash,
	formatTrafficGb,
} from '@/lib/domain/monitoring/format.ts'
import {
	FLEET_CRITICAL_PERCENT,
	FLEET_WARN_PERCENT,
} from '@/lib/domain/monitoring/monitoring-thresholds.ts'
import { summarizeSeries } from '@/lib/domain/monitoring/series-summary.ts'
import { rangeToHours } from '@/lib/domain/monitoring/vps-metrics.ts'

import type { VpsGauges } from '@/lib/adapters/victoria/metrics.ts'
import type { FleetVps } from '@/lib/domain/monitoring/fleet-vps.ts'
import type { HostFacts } from '@/lib/domain/monitoring/host-facts.ts'
import type { ServerMetrics } from '@/lib/domain/monitoring/fleet-overview.ts'
import type { HostMetrics } from '@/lib/domain/monitoring/host-metrics.ts'
import type { LoadState } from '@/lib/domain/load-state.ts'
import type { RangePoint } from '@/lib/domain/monitoring/promql-response.ts'
import type { VpsSeriesMetric } from '@/lib/domain/monitoring/vps-metrics.ts'

interface Props {
	slug: string
	vps: FleetVps | null
	facts: HostFacts
	range: string
}

interface Threshold {
	value: number
	label: string
	severity: 'warning' | 'critical'
}

const DISK_LATENCY_WARNING = 10
const SWAP_AMBER = 15
const PCT_FULL = 100
const BYTES_PER_GB = 1_000_000_000
const LOAD_DECIMALS = 2
const CMP_CONCURRENCY = 6
const EMPTY_FLEET: ReadonlyArray<FleetVps> = []
const PERCENT_THRESHOLDS: ReadonlyArray<Threshold> = [
	{ value: FLEET_WARN_PERCENT, label: 'warning', severity: 'warning' },
	{ value: FLEET_CRITICAL_PERCENT, label: 'critical', severity: 'critical' },
]

const NULL_HOST: HostMetrics = {
	cpuPercent: null,
	memoryPercent: null,
	diskPercent: null,
	uptimeSeconds: null,
}
const NULL_GAUGES: VpsGauges = {
	load1: null,
	load5: null,
	load15: null,
	swapPercent: null,
	netInMbps: null,
	netOutMbps: null,
}

const { slug, vps, facts, range } = Astro.props

const hours = rangeToHours(range)

const unwrap = <T,>(state: LoadState<T>, fallback: T): T =>
	state.kind === 'ok' ? state.data : fallback
const seriesOf = (state: LoadState<ReadonlyArray<RangePoint>>): ReadonlyArray<RangePoint> =>
	state.kind === 'ok' ? state.data : []

const seriesMetrics: ReadonlyArray<VpsSeriesMetric> = [
	'cpu',
	'mem',
	'netOut',
	'diskIo',
	'diskLatency',
	'load',
	'netIn',
]

// Host gauges, the fleet list, the traffic totals and every series share no
// data, so they fire in one parallel wave instead of serialized awaits.
const [hostState, gaugesState, fleetState, trafficState, seriesStates] =
	await Promise.all([
		loadPageState(`vps.${slug}.host`, () => loadHostMetrics(slug)),
		loadPageState(`vps.${slug}.gauges`, () => loadVpsGauges(slug)),
		loadPageState(`vps.${slug}.fleet`, () => listFleetVps()),
		loadPageState(`vps.${slug}.traffic.${String(hours)}`, () =>
			loadTrafficTotals(slug, hours),
		),
		Promise.all(
			seriesMetrics.map((metric) =>
				loadPageState(`vps.${slug}.series.${metric}`, () =>
					loadVpsSeries(slug, metric, hours),
				),
			),
		),
	])
const host = unwrap(hostState, NULL_HOST)
const gauges = unwrap(gaugesState, NULL_GAUGES)
const fleet = unwrap(fleetState, EMPTY_FLEET)
const traffic = unwrap(trafficState, NULL_TRAFFIC_TOTALS)

const seriesAt = (metric: VpsSeriesMetric): ReadonlyArray<RangePoint> => {
	const index = seriesMetrics.indexOf(metric)
	if (index === -1) return []
	const state = seriesStates[index]
	return state ? seriesOf(state) : []
}
const cpuSeries = seriesAt('cpu')
const memSeries = seriesAt('mem')
const netOutSeries = seriesAt('netOut')
const diskIoSeries = seriesAt('diskIo')
const diskLatencySeries = seriesAt('diskLatency')
const loadSeries = seriesAt('load')
const netInSeries = seriesAt('netIn')

const valuesOf = (points: ReadonlyArray<RangePoint>): ReadonlyArray<number> =>
	points.map((point) => point.v)

// The fleet comparison island owns metric selection client-side; the server
// only seeds the INITIAL metric (cpu) so the panel paints with no fetch. Bound
// the fan-out (one range query per peer) and reuse the current host's
// already-loaded cpu series instead of querying the identical range twice.
const cpuCmpLines = await mapWithConcurrency(
	fleet,
	CMP_CONCURRENCY,
	async (peer) => {
		if (peer.name === slug) {
			return { name: peer.name, values: valuesOf(seriesAt('cpu')) }
		}
		const state = await loadPageState(`vps.${slug}.cmp.${peer.name}`, () =>
			loadVpsSeries(peer.name, 'cpu', hours),
		)
		return { name: peer.name, values: valuesOf(seriesOf(state)) }
	},
)

const metricsByName: Record<string, ServerMetrics> = {}
if (vps !== null) {
	metricsByName[vps.name] = {
		cpuPercent: host.cpuPercent,
		memoryPercent: host.memoryPercent,
		diskPercent: host.diskPercent,
	}
}
const alerts = vps === null ? [] : deriveFleetAlerts([vps], metricsByName)

// Facts stay nullable end-to-end: a failed facts load must render "-", never
// a fake "0 cores" / "0 GB" capacity beside real percentage gauges.
const { cores } = facts
const memoryGb = bytesToWholeGb(facts.memoryTotalBytes)
const diskGb = bytesToWholeDecimalGb(facts.diskTotalBytes)
const coresLabel = cores === null ? EMPTY_LABEL : `${cores} cores`

const formatSummaryStat = (stat: number | null): string | null => {
	if (stat === null) return null
	return stat.toFixed(1)
}
const summaryOf = (
	points: ReadonlyArray<RangePoint>,
): { avg: string | null; peak: string | null } => {
	const summary = summarizeSeries(points)
	return {
		avg: formatSummaryStat(summary.average),
		peak: formatSummaryStat(summary.peak),
	}
}
const lastValue = (points: ReadonlyArray<RangePoint>): number | null =>
	points.at(-1)?.v ?? null

const cpuSummary = summaryOf(cpuSeries)
const memSummary = summaryOf(memSeries)
const netOutSummary = summaryOf(netOutSeries)
const diskIoSummary = summaryOf(diskIoSeries)
const diskLatencySummary = summaryOf(diskLatencySeries)
const loadSummary = summaryOf(loadSeries)

const netCurrent = gauges.netOutMbps ?? lastValue(netOutSeries)
const ioCurrent = lastValue(diskIoSeries)
const latencyCurrent = lastValue(diskLatencySeries)
const loadCurrent = gauges.load1 ?? lastValue(loadSeries)

const memSub =
	memoryGb === null
		? EMPTY_LABEL
		: host.memoryPercent === null
			? `${memoryGb} GB`
			: `${((host.memoryPercent / PCT_FULL) * memoryGb).toFixed(1)} / ${memoryGb} GB`
const diskSub =
	diskGb === null
		? EMPTY_LABEL
		: host.diskPercent === null
			? `${diskGb} GB`
			: `${((host.diskPercent / PCT_FULL) * diskGb).toFixed(0)} / ${diskGb} GB`

const windowIn =
	traffic.inBytes === null
		? EMPTY_LABEL
		: formatTrafficGb(traffic.inBytes / BYTES_PER_GB)
const windowOut =
	traffic.outBytes === null
		? EMPTY_LABEL
		: formatTrafficGb(traffic.outBytes / BYTES_PER_GB)

const latencyThresholds: ReadonlyArray<Threshold> = [
	{ value: DISK_LATENCY_WARNING, label: 'lent', severity: 'warning' },
]
// No threshold when the core count is unknown: a `value: 0` line would draw
// a critical baseline that flags ALL load as saturated.
const loadThresholds: ReadonlyArray<Threshold> =
	cores === null
		? []
		: [{ value: cores, label: coresLabel, severity: 'critical' }]

const netCombinedValues = [...valuesOf(netInSeries), ...valuesOf(netOutSeries)]
const netCombinedMax =
	netCombinedValues.length > 0 ? Math.max(...netCombinedValues) : undefined

const swapText = formatPercentOrDash(gauges.swapPercent)
const swapAmber =
	gauges.swapPercent !== null && gauges.swapPercent > SWAP_AMBER
---

{
	vps === null ? (
		// The page only mounts this island for a resolved server, so a null prop
		// here means the header lookup raced to empty - the page already owns the
		// not-found / error banner, so the island stays silent rather than
		// repeating a (here unknowable) cause.
		<div />
	) : (
		// No own width wrapper: the layout's content shell already caps and
		// centres the column. The island is a flex-item of the page's
		// `flex flex-col` container, so an `mx-auto` here would cancel the
		// cross-axis stretch and shrink the island to its content width.
		<div class="flex flex-col gap-[18px]">
			{alerts.length > 0 && (
				<section class="overflow-hidden rounded-xl border border-red-200 bg-white shadow-subtle">
					{alerts.map((alert) => (
						<AlertRow alert={alert} />
					))}
				</section>
			)}

			<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,150px),1fr))] gap-3.5">
				<div class="flex justify-center rounded-xl border border-base-200 bg-white p-4 shadow-subtle">
					<RadialGauge
						value={host.cpuPercent ?? 0}
						label="CPU"
						sub={coresLabel}
					/>
				</div>
				<div class="flex justify-center rounded-xl border border-base-200 bg-white p-4 shadow-subtle">
					<RadialGauge
						value={host.memoryPercent ?? 0}
						label="Mémoire"
						sub={memSub}
					/>
				</div>
				<div class="flex justify-center rounded-xl border border-base-200 bg-white p-4 shadow-subtle">
					<RadialGauge
						value={host.diskPercent ?? 0}
						label="Disque"
						sub={diskSub}
					/>
				</div>

				<div class="flex flex-col justify-center gap-2 rounded-xl border border-base-200 bg-white p-4 shadow-subtle">
					<div class="flex justify-between">
						<span class="text-xs text-base-500">Load 1m</span>
						<span class="font-mono font-bold text-base-900">
							{formatFixedOrDash(gauges.load1, LOAD_DECIMALS)}
						</span>
					</div>
					<div class="flex justify-between">
						<span class="text-xs text-base-500">Load 5m</span>
						<span class="font-mono font-bold text-base-900">
							{formatFixedOrDash(gauges.load5, LOAD_DECIMALS)}
						</span>
					</div>
					<div class="flex justify-between">
						<span class="text-xs text-base-500">Load 15m</span>
						<span class="font-mono font-bold text-base-900">
							{formatFixedOrDash(gauges.load15, LOAD_DECIMALS)}
						</span>
					</div>
					<div class="my-0.5 border-t border-base-100" />
					<div class="flex justify-between">
						<span class="text-xs text-base-500">Swap</span>
						<span
							class:list={[
								'font-mono font-bold',
								swapAmber ? 'text-amber-600' : 'text-base-900',
							]}
						>
							{swapText}
						</span>
					</div>
				</div>

				<div class="flex flex-col justify-center gap-2 rounded-xl border border-base-200 bg-white p-4 shadow-subtle">
					<div class="flex items-center gap-1.5 text-accent-600">
						<Icon name="arrowDown" size={14} />
						<span class="text-xs text-base-600">In</span>
						<span class="ml-auto font-mono font-bold text-base-900">
							{formatFixedOrDash(gauges.netInMbps)}
							<span class="text-[11px] font-normal text-base-500"> Mb/s</span>
						</span>
					</div>
					<div class="flex items-center gap-1.5 text-sky-600">
						<Icon name="arrowUp" size={14} />
						<span class="text-xs text-base-600">Out</span>
						<span class="ml-auto font-mono font-bold text-base-900">
							{formatFixedOrDash(gauges.netOutMbps)}
							<span class="text-[11px] font-normal text-base-500"> Mb/s</span>
						</span>
					</div>
					<div class="my-0.5 border-t border-base-100" />
					<div class="flex justify-between">
						<span class="text-xs text-base-500">Fenêtre ↓</span>
						<span class="font-mono font-semibold text-base-900">{windowIn}</span>
					</div>
					<div class="flex justify-between">
						<span class="text-xs text-base-500">Fenêtre ↑</span>
						<span class="font-mono font-semibold text-base-900">{windowOut}</span>
					</div>
				</div>
			</div>

			<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-3.5">
				<VpsMetricPanel
					title="CPU"
					icon="cpu"
					color="accent"
					unit="%"
					current={formatRoundedOrDash(host.cpuPercent)}
					avg={cpuSummary.avg}
					peak={cpuSummary.peak}
					values={valuesOf(cpuSeries)}
					max={PCT_FULL}
					thresholds={PERCENT_THRESHOLDS}
				/>
				<VpsMetricPanel
					title="Mémoire"
					icon="ram"
					color="info"
					unit="%"
					current={formatRoundedOrDash(host.memoryPercent)}
					avg={memSummary.avg}
					peak={memSummary.peak}
					values={valuesOf(memSeries)}
					max={PCT_FULL}
					thresholds={PERCENT_THRESHOLDS}
				/>
				<VpsMetricPanel
					title="Réseau"
					icon="net"
					color="slate"
					unit=" Mb/s"
					current={formatFixedOrDash(netCurrent)}
					avg={netOutSummary.avg}
					peak={netOutSummary.peak}
					values={valuesOf(netOutSeries)}
				/>
				<VpsMetricPanel
					title="Disque I/O"
					icon="disk"
					color="warning"
					unit=" MB/s"
					current={formatFixedOrDash(ioCurrent)}
					avg={diskIoSummary.avg}
					peak={diskIoSummary.peak}
					values={valuesOf(diskIoSeries)}
				/>
				<VpsMetricPanel
					title="Latence disque"
					icon="gauge"
					color="slate"
					unit=" ms"
					current={formatFixedOrDash(latencyCurrent)}
					avg={diskLatencySummary.avg}
					peak={diskLatencySummary.peak}
					values={valuesOf(diskLatencySeries)}
					thresholds={latencyThresholds}
				/>
				<VpsMetricPanel
					title="Load average"
					icon="activity"
					color="accent"
					unit=""
					current={formatFixedOrDash(loadCurrent, LOAD_DECIMALS)}
					avg={loadSummary.avg}
					peak={loadSummary.peak}
					values={valuesOf(loadSeries)}
					thresholds={loadThresholds}
				/>
			</div>

			<div class="overflow-hidden rounded-xl border border-base-200 bg-white shadow-subtle">
				<header class="flex items-center justify-between border-b border-base-200 px-4 py-3.5">
					<span class="text-sm font-semibold text-base-900">
						Trafic réseau ↓ in / ↑ out
					</span>
					<div class="flex gap-3.5 text-xs">
						<span class="flex items-center gap-1.5">
							<span class="size-2.5 rounded-full bg-sky-600" />
							In
						</span>
						<span class="flex items-center gap-1.5">
							<span class="size-2.5 rounded-full bg-accent-600" />
							Out
						</span>
					</div>
				</header>
				<div class="px-2.5 pt-3 pb-1.5">
					<MultiLine
						unit=" Mb/s"
						max={netCombinedMax}
						series={[
							{ name: 'In', color: 'info', values: valuesOf(netInSeries) },
							{ name: 'Out', color: 'accent', values: valuesOf(netOutSeries) },
						]}
					/>
				</div>
			</div>

			<FleetComparison
				client:load
				slug={slug}
				range={range}
				initialLines={cpuCmpLines}
			/>

			<div class="overflow-hidden rounded-xl border border-base-200 bg-white shadow-subtle">
				<header class="border-b border-base-200 px-4 py-3.5">
					<span class="text-sm font-semibold text-base-900">Processus</span>
				</header>
				<p class="px-4 py-6 text-sm text-base-500">
					Indisponible - process_exporter non déployé
				</p>
			</div>
		</div>
	)
}
