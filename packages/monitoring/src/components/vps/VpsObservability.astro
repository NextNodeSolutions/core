---
import LoadStateBanner from '@/components/dashboard/LoadStateBanner.astro'
import VpsCaddyStats from '@/components/vps/VpsCaddyStats.astro'
import VpsContainerLogs from '@/components/vps/VpsContainerLogs.astro'
import VpsHostMetrics from '@/components/vps/VpsHostMetrics.astro'
import { ENV_KEYS, getEnv } from '@/lib/adapters/env.ts'
import { loadPageState } from '@/lib/adapters/load-page-state.ts'
import { getVpsState } from '@/lib/adapters/r2/state.ts'
import {
	loadCaddyStats,
	loadHostMetrics,
	loadProjectLogs,
} from '@/lib/adapters/victoria/observability.ts'
import { selectOwnerProject } from '@/lib/domain/hetzner/vps-state.ts'
import type { CaddyHostStat } from '@/lib/domain/monitoring/caddy-stats.ts'
import type { HostMetrics } from '@/lib/domain/monitoring/host-metrics.ts'
import type { LogLine } from '@/lib/domain/monitoring/log-query.ts'

interface Props {
	slug: string
}

const { slug } = Astro.props

const EMPTY_METRICS: HostMetrics = {
	cpuPercent: null,
	memoryPercent: null,
	diskPercent: null,
	uptimeSeconds: null,
}

// Owner project drives the log + Caddy panels. Resolved from R2 state;
// null (missing creds, fresh VPS) leaves those panels in their empty
// state without failing the metrics panel.
const resolveOwnerProject = async (): Promise<string | null> => {
	const accountId = getEnv(ENV_KEYS.CLOUDFLARE_ACCOUNT_ID)
	const accessKeyId = getEnv(ENV_KEYS.R2_ACCESS_KEY_ID)
	const secretAccessKey = getEnv(ENV_KEYS.R2_SECRET_ACCESS_KEY)
	if (!accountId || !accessKeyId || !secretAccessKey) return null
	const state = await getVpsState(
		{ accountId, accessKeyId, secretAccessKey },
		slug,
	)
	return state === null ? null : selectOwnerProject(state, slug)
}

const ownerProject = await resolveOwnerProject().catch(() => null)

const metricsState = await loadPageState(`observability.metrics.${slug}`, () =>
	loadHostMetrics(slug),
)

const logsState = await loadPageState(`observability.logs.${slug}`, () =>
	ownerProject === null
		? Promise.resolve<ReadonlyArray<LogLine>>([])
		: loadProjectLogs(ownerProject),
)

const caddyState = await loadPageState(`observability.caddy.${slug}`, () =>
	ownerProject === null
		? Promise.resolve<ReadonlyArray<CaddyHostStat>>([])
		: loadCaddyStats(ownerProject),
)

const metrics = metricsState.kind === 'ok' ? metricsState.data : EMPTY_METRICS
const logs = logsState.kind === 'ok' ? logsState.data : []
const caddyStats = caddyState.kind === 'ok' ? caddyState.data : []
---

<VpsHostMetrics metrics={metrics} />

<section class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
	<VpsContainerLogs project={ownerProject} lines={logs} />
	<VpsCaddyStats project={ownerProject} stats={caddyStats} />
</section>

<LoadStateBanner state={metricsState} upstreamLabel="VictoriaMetrics error" />
