---
import Icon from '@/components/foundations/Icon.astro'

export interface Breadcrumb {
	label: string
	href?: string
}

interface Props {
	title: string
	crumbs?: Breadcrumb[]
}

const { title, crumbs = [] } = Astro.props
---

<header
	class="sticky top-0 z-20 flex h-[60px] shrink-0 items-center gap-4 overflow-hidden border-b border-base-200 bg-white/85 px-6 backdrop-blur"
>
	<div class="min-w-0 flex-1">
		{
			crumbs.length > 0 && (
				<div class="flex items-center gap-1.5 truncate font-mono text-[11px] text-base-500">
					{crumbs.map((crumb, index) => (
						<>
							{index > 0 && <Icon name="chevron" size={11} />}
							{crumb.href ? (
								<a href={crumb.href} class="hover:text-base-900">
									{crumb.label}
								</a>
							) : (
								<span>{crumb.label}</span>
							)}
						</>
					))}
				</div>
			)
		}
		<h1
			class="truncate font-display text-lg font-semibold tracking-[-0.02em] text-base-900"
		>
			{title}
		</h1>
	</div>
	<div class="flex shrink-0 items-center gap-2.5">
		<slot name="actions" />
	</div>
</header>
