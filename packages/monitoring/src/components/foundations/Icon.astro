---
/**
 * Thin wrapper over the Lucide icon set. `name` selects the glyph; `size` sets
 * width/height in px. Keeping the `<Icon name="…"/>` indirection (rather than
 * importing Lucide components at each call site) preserves a single typed
 * `IconName` union the whole dashboard shares, and keeps the 1.7 stroke /
 * sizing defaults in one place.
 *
 * GitHub is the lone exception: Lucide dropped brand marks for trademark
 * reasons, so it stays a raw inline glyph.
 */
import {
	Activity,
	ArrowDown,
	ArrowUp,
	Bell,
	Check,
	ChevronRight,
	Clock,
	Cpu,
	Dot,
	ExternalLink,
	Flame,
	Funnel,
	Gauge,
	GitBranch,
	HardDrive,
	LayoutGrid,
	MapPin,
	MemoryStick,
	Network,
	RefreshCw,
	Rocket,
	ScrollText,
	Search,
	Server,
	Shield,
	Trash2,
	TriangleAlert,
	X,
} from '@lucide/astro'

const GLYPHS = {
	grid: LayoutGrid,
	server: Server,
	logs: ScrollText,
	rocket: Rocket,
	branch: GitBranch,
	search: Search,
	bell: Bell,
	cpu: Cpu,
	ram: MemoryStick,
	disk: HardDrive,
	net: Network,
	clock: Clock,
	gauge: Gauge,
	activity: Activity,
	arrowUp: ArrowUp,
	arrowDown: ArrowDown,
	chevron: ChevronRight,
	x: X,
	check: Check,
	refresh: RefreshCw,
	trash: Trash2,
	external: ExternalLink,
	alert: TriangleAlert,
	shield: Shield,
	location: MapPin,
	filter: Funnel,
	dot: Dot,
	flame: Flame,
}

const GITHUB_GLYPH =
	'<path d="M9 19c-4 1.5-4-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.3 2.3 5.3 2.6 5.3 2.6a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 3.8 9c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>'

export type IconName = keyof typeof GLYPHS | 'github'

interface Props {
	name: IconName
	size?: number
	class?: string
}

const DEFAULT_ICON_SIZE = 18
const STROKE_WIDTH = 1.7

const { name, size = DEFAULT_ICON_SIZE, class: className } = Astro.props
const Glyph = name === 'github' ? null : GLYPHS[name]
---

{
	Glyph === null ? (
		<svg
			width={size}
			height={size}
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width={STROKE_WIDTH}
			stroke-linecap="round"
			stroke-linejoin="round"
			class={className}
			aria-hidden="true"
			set:html={GITHUB_GLYPH}
		/>
	) : (
		<Glyph
			size={size}
			stroke-width={STROKE_WIDTH}
			class={className}
			aria-hidden="true"
		/>
	)
}
