---
/**
 * Stroke icon set ported from the design handoff (1.7 stroke, currentColor).
 * `name` selects the glyph; `size` sets width/height in px.
 */
const ICON_NAMES = [
	'grid', 'server', 'logs', 'rocket', 'github', 'branch', 'search', 'bell',
	'cpu', 'ram', 'disk', 'net', 'clock', 'gauge', 'activity', 'arrowUp',
	'arrowDown', 'chevron', 'chevronDown', 'x', 'check', 'play', 'pause',
	'refresh', 'trash', 'external', 'copy', 'alert', 'shield', 'location',
	'filter', 'dot', 'flame', 'layers',
] as const

export type IconName = (typeof ICON_NAMES)[number]

interface Props {
	name: IconName
	size?: number
	class?: string
}

const DEFAULT_ICON_SIZE = 18

const { name, size = DEFAULT_ICON_SIZE, class: className } = Astro.props

const glyphs: Record<IconName, string> = {
	grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
	server: '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
	logs: '<path d="M4 5h16M4 10h10M4 15h16M4 20h7"/>',
	rocket: '<path d="M5 15c-1.5 1.5-2 5-2 5s3.5-.5 5-2c.83-.83.83-2.17 0-3s-2.17-.83-3 0Z"/><path d="M9 12a14 14 0 0 1 8-9 14 14 0 0 1-1 11 6 6 0 0 1-3 1l-3-3a6 6 0 0 1 1-3Z"/><circle cx="15" cy="9" r="1.4"/>',
	github: '<path d="M9 19c-4 1.5-4-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.3 2.3 5.3 2.6 5.3 2.6a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 3.8 9c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
	branch: '<circle cx="6" cy="6" r="2.4"/><circle cx="6" cy="18" r="2.4"/><circle cx="18" cy="8" r="2.4"/><path d="M6 8.4v7.2M18 10.4c0 3-3 4-6 4"/>',
	search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/>',
	bell: '<path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/>',
	cpu: '<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4"/>',
	ram: '<rect x="2" y="7" width="20" height="10" rx="2"/><path d="M6 7v-1M10 7v-1M14 7v-1M18 7v-1M6 21v-2M10 21v-2M14 21v-2M18 21v-2"/>',
	disk: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.6"/><path d="M12 3a9 9 0 0 1 6.4 2.6"/>',
	net: '<path d="M5 12a7 7 0 0 1 14 0"/><path d="M2 12a10 10 0 0 1 20 0"/><path d="M8.5 12a3.5 3.5 0 0 1 7 0"/><circle cx="12" cy="19" r="1.2" fill="currentColor" stroke="none"/>',
	clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	gauge: '<path d="M12 14 16 9"/><path d="M3.4 16a9 9 0 1 1 17.2 0"/><circle cx="12" cy="14" r="1.4" fill="currentColor" stroke="none"/>',
	activity: '<path d="M3 12h4l3 8 4-16 3 8h4"/>',
	arrowUp: '<path d="M12 19V5M6 11l6-6 6 6"/>',
	arrowDown: '<path d="M12 5v14M6 13l6 6 6-6"/>',
	chevron: '<path d="m9 6 6 6-6 6"/>',
	chevronDown: '<path d="m6 9 6 6 6-6"/>',
	x: '<path d="M18 6 6 18M6 6l12 12"/>',
	check: '<path d="M20 6 9 17l-5-5"/>',
	play: '<path d="M6 4l14 8-14 8V4Z" fill="currentColor" stroke="none"/>',
	pause: '<rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor" stroke="none"/><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor" stroke="none"/>',
	refresh: '<path d="M21 12a9 9 0 1 1-2.6-6.3M21 4v5h-5"/>',
	trash: '<path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"/>',
	external: '<path d="M14 4h6v6M20 4l-9 9M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/>',
	copy: '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h8"/>',
	alert: '<path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/>',
	shield: '<path d="M12 3 5 6v6c0 4 3 7 7 9 4-2 7-5 7-9V6l-7-3Z"/>',
	location: '<path d="M12 21s-7-5.7-7-11a7 7 0 0 1 14 0c0 5.3-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
	filter: '<path d="M3 5h18l-7 8v6l-4-2v-4L3 5Z"/>',
	dot: '<circle cx="12" cy="12" r="3" fill="currentColor" stroke="none"/>',
	flame: '<path d="M12 3c1 3 4 4.5 4 8a4 4 0 0 1-8 0c0-1 .3-1.8 1-2.5C9 11 12 9 12 3Z"/>',
	layers: '<path d="m12 3 9 5-9 5-9-5 9-5ZM3 13l9 5 9-5M3 17l9 5 9-5"/>',
}
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.7"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
	set:html={glyphs[name]}
/>
