---
import Icon from '@/components/foundations/Icon.astro'
import type { IconName } from '@/components/foundations/Icon.astro'
import type { HetznerVps } from '@/lib/domain/hetzner/vps.ts'
import { formatUptime } from '@/lib/domain/monitoring/format.ts'
import type { FleetHealth } from '@/lib/domain/monitoring/fleet-overview.ts'
import type { HostMetrics } from '@/lib/domain/monitoring/host-metrics.ts'

interface Props {
	server: HetznerVps
	metrics: HostMetrics
	health: FleetHealth
}

const { server, metrics, health } = Astro.props

const WARNING_PERCENT = 75
const CRITICAL_PERCENT = 90

const healthPresentation: Record<
	FleetHealth,
	{ dot: string; badge: string; label: string }
> = {
	running: {
		dot: 'bg-accent-600',
		badge: 'bg-accent-50 text-accent-800 border-accent-200',
		label: 'running',
	},
	warning: {
		dot: 'bg-amber-500',
		badge: 'bg-amber-50 text-amber-700 border-amber-200',
		label: 'warning',
	},
	critical: {
		dot: 'bg-red-600',
		badge: 'bg-red-50 text-red-700 border-red-200',
		label: 'critical',
	},
	down: {
		dot: 'bg-base-400',
		badge: 'bg-base-100 text-base-600 border-base-200',
		label: 'hors ligne',
	},
}

const tone = healthPresentation[health]

interface MetricRow {
	label: string
	icon: IconName
	percent: number | null
}

const rows: MetricRow[] = [
	{ label: 'CPU', icon: 'cpu', percent: metrics.cpuPercent },
	{ label: 'RAM', icon: 'ram', percent: metrics.memoryPercent },
	{ label: 'Disque', icon: 'disk', percent: metrics.diskPercent },
]

function barColor(percent: number | null): string {
	if (percent === null) return 'bg-base-300'
	if (percent >= CRITICAL_PERCENT) return 'bg-red-600'
	if (percent >= WARNING_PERCENT) return 'bg-amber-500'
	return 'bg-accent-600'
}

const role = server.labels['role'] ?? server.serverType.description
const uptime =
	metrics.uptimeSeconds === null ? '-' : formatUptime(metrics.uptimeSeconds)
---

<a
	href={`/vps/${server.name}`}
	class="block overflow-hidden rounded-xl border border-base-200 bg-white shadow-subtle transition-shadow hover:shadow-navy"
>
	<div class="flex items-start justify-between gap-3 px-4 pt-4">
		<div class="min-w-0">
			<div class="flex items-center gap-2">
				<span class:list={['inline-block size-2 rounded-full', tone.dot]}></span>
				<span class="truncate font-mono text-sm font-bold text-base-900">
					{server.name}
				</span>
			</div>
			<p class="mt-1 truncate text-xs text-base-500">{role}</p>
		</div>
		<div class="shrink-0 text-right">
			<span
				class:list={[
					'inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[11px] font-medium',
					tone.badge,
				]}
			>
				<span class:list={['size-1.5 rounded-full', tone.dot]}></span>
				{tone.label}
			</span>
			<p
				class="mt-1.5 flex items-center justify-end gap-1 font-mono text-[10.5px] text-base-500"
			>
				<Icon name="location" size={11} />
				{server.location.city ?? server.location.name}
			</p>
		</div>
	</div>

	<div class="flex flex-col gap-2.5 px-4 pt-3 pb-2">
		{
			rows.map((row) => (
				<div class="flex items-center gap-2.5">
					<span class="shrink-0 text-base-400">
						<Icon name={row.icon} size={14} />
					</span>
					<span class="w-11 shrink-0 text-[11.5px] text-base-500">
						{row.label}
					</span>
					<span class="h-1.5 flex-1 overflow-hidden rounded-full bg-base-100">
						<span
							class:list={['block h-full rounded-full', barColor(row.percent)]}
							style={`width:${row.percent === null ? 0 : Math.round(row.percent)}%`}
						/>
					</span>
					<span class="w-9 text-right font-mono text-[12.5px] font-semibold tabular-nums">
						{row.percent === null ? '-' : `${Math.round(row.percent)}%`}
					</span>
				</div>
			))
		}
	</div>

	<div
		class="flex items-center justify-between border-t border-base-100 bg-base-50 px-4 py-2.5"
	>
		<div>
			<p class="text-[10px] text-base-500">Uptime</p>
			<p class="font-mono text-xs font-semibold text-base-900">{uptime}</p>
		</div>
		<div class="text-right">
			<p class="text-[10px] text-base-500">Type</p>
			<p class="font-mono text-xs font-semibold text-base-900">
				{server.serverType.name}
			</p>
		</div>
	</div>
</a>
