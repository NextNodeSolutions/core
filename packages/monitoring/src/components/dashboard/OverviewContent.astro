---
import AlertRow from '@/components/dashboard/AlertRow.astro'
import FleetCard from '@/components/dashboard/FleetCard.astro'
import Icon from '@/components/foundations/Icon.astro'
import LoadStateBanner from '@/components/dashboard/LoadStateBanner.astro'
import { Overview } from '@/islands/overview/Overview.tsx'
import { ENV_KEYS, requireEnv } from '@/lib/adapters/env.ts'
import { listServers } from '@/lib/adapters/hetzner/servers.ts'
import { loadPageState } from '@/lib/adapters/load-page-state.ts'
import { loadOverviewWindow } from '@/lib/adapters/overview.ts'
import {
	loadHostMetrics,
	loadVpsGauges,
	loadVpsSeries,
} from '@/lib/adapters/victoria/metrics.ts'
import { loadRecentDeployments } from '@/lib/adapters/cloudflare/recent-deployments.ts'
import { loadVpsDeployRuns } from '@/lib/adapters/github/vps-deployments.ts'
import {
	DEPLOY_STATUS_COLOR,
	DEPLOY_STATUS_ICON,
} from '@/components/cloudflare/deploy-display.ts'
import {
	CONTEXT_PILL_CLASS,
	ENV_PILL_CLASS,
	ENV_PILL_LABEL,
	SOURCE_PILL_CLASS,
	SOURCE_PILL_LABEL,
} from '@/components/deployments/activity-display.ts'
import { activityRowView } from '@/lib/domain/deployments/activity-view.ts'
import { deploymentSelectionHref } from '@/lib/domain/deployments/deployment-routes.ts'
import {
	mergeActivity,
	selectRecentActivity,
} from '@/lib/domain/deployments/deployment-activity.ts'
import {
	computeServerHealth,
	deriveFleetAlerts,
} from '@/lib/domain/monitoring/fleet-overview.ts'
import { formatRelative } from '@/lib/domain/monitoring/format.ts'

import type { ActivityTarget } from '@/lib/domain/deployments/activity-view.ts'
import type { HostMetrics } from '@/lib/domain/monitoring/host-metrics.ts'

const DEPLOY_COUNT = 4
// Per deploy workflow, a handful of latest runs is enough to fill a 4-row
// merged feed (mirrors recent-deployments.ts' PER_PROJECT_LIMIT).
const VPS_RUNS_PER_WORKFLOW = 5
// The fleet card sparkline is a "now" glance, not a windowed series - it never
// follows the island's range control, so it loads at a fixed short window.
const SPARK_HOURS = 1

interface Props {
	range: string
}

const { range } = Astro.props

const NULL_METRICS: HostMetrics = {
	cpuPercent: null,
	memoryPercent: null,
	diskPercent: null,
	uptimeSeconds: null,
}

interface FleetExtra {
	cpuTrend: ReadonlyArray<number>
	loadAvg: number | null
	netOutMbps: number | null
}

const serversState = await loadPageState('overview.servers', () => {
	const token = requireEnv(ENV_KEYS.HETZNER_API_TOKEN)
	return listServers(token)
})
const servers = serversState.kind === 'ok' ? serversState.data : []

// The range-INDEPENDENT sections (fleet grid + alerts, recent deployments) are
// "now" snapshots rendered once here; the range-DEPENDENT window (stats + log
// preview) is loaded as the island seed. They hit independent upstreams, so
// kick everything off together and await once.
const fleetLoadsPromise = Promise.all(
	servers.map(async (server) => {
		const [metricsState, gaugesState, sparkState] = await Promise.all([
			loadPageState(`overview.metrics.${server.name}`, () =>
				loadHostMetrics(server.name),
			),
			loadPageState(`overview.gauges.${server.name}`, () =>
				loadVpsGauges(server.name),
			),
			loadPageState(`overview.spark.${server.name}`, () =>
				loadVpsSeries(server.name, 'cpu', SPARK_HOURS),
			),
		])
		return { name: server.name, metricsState, gaugesState, sparkState }
	}),
)
const recentStatePromise = loadPageState('overview.deployments', () =>
	loadRecentDeployments(DEPLOY_COUNT),
)
const vpsRunsStatePromise = loadPageState('overview.vpsRuns', () =>
	loadVpsDeployRuns(VPS_RUNS_PER_WORKFLOW),
)
const seedPromise = loadOverviewWindow(range)
const [fleetLoads, recentState, vpsRunsState, seed] = await Promise.all([
	fleetLoadsPromise,
	recentStatePromise,
	vpsRunsStatePromise,
	seedPromise,
])

const metricsByName: Record<string, HostMetrics> = {}
const fleetExtras: Record<string, FleetExtra> = {}
for (const load of fleetLoads) {
	metricsByName[load.name] =
		load.metricsState.kind === 'ok' ? load.metricsState.data : NULL_METRICS
	const gauges = load.gaugesState.kind === 'ok' ? load.gaugesState.data : null
	const points = load.sparkState.kind === 'ok' ? load.sparkState.data : []
	fleetExtras[load.name] = {
		cpuTrend: points.map((point) => point.v),
		loadAvg: gauges?.load1 ?? null,
		netOutMbps: gauges?.netOutMbps ?? null,
	}
}

const alerts = deriveFleetAlerts(servers, metricsByName)

const nowMs = Date.now()
// Merge both sources newest-first; each source degrades to [] independently
// (its failure is logged by loadPageState), so one API down never blanks the
// other's rows.
const recentEntries = selectRecentActivity(
	mergeActivity(
		recentState.kind === 'ok' ? recentState.data : [],
		vpsRunsState.kind === 'ok' ? vpsRunsState.data : [],
	),
	'all',
	DEPLOY_COUNT,
)
const recentDeploys = recentEntries.map(activityRowView)
// The SSR interpreter of a row's semantic target: everything is an anchor
// here; the island renders the deployment case as a drawer-opening button.
const targetHref = (target: ActivityTarget): string =>
	target.kind === 'external'
		? target.href
		: deploymentSelectionHref(target.projectName, target.deploymentId)
---

<div class="flex flex-col gap-5">
	<Overview client:load seed={seed} />

	{
		alerts.length > 0 && (
			<section class="overflow-hidden rounded-xl border border-base-200 bg-white shadow-subtle">
				<header class="flex items-center justify-between border-b border-base-200 px-4 py-3.5">
					<div class="flex items-center gap-2.5">
						<span class="text-sm font-semibold text-base-900">Alertes actives</span>
						<span class="inline-flex items-center gap-1.5 rounded-full border border-red-200 bg-red-50 px-2 py-0.5 text-[11px] font-medium text-red-700">
							<span class="size-1.5 rounded-full bg-red-600" />
							{alerts.length}
						</span>
					</div>
				</header>
				{alerts.map((alert) => (
					<AlertRow alert={alert} withVpsLink />
				))}
			</section>
		)
	}

	<section>
		<div class="mb-3 flex items-center justify-between">
			<span
				class="inline-flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-base-700"
			>
				<span class="size-2.5 rounded-[2px] bg-base-900"></span>
				Fleet Hetzner
			</span>
			<span class="text-xs text-base-500">
				Cliquez un nœud pour les métriques détaillées
			</span>
		</div>
		{
			servers.length > 0 ? (
				<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-3.5">
					{servers.map((server) => (
						<FleetCard
							server={server}
							metrics={metricsByName[server.name] ?? NULL_METRICS}
							health={computeServerHealth(
								server.status,
								metricsByName[server.name] ?? NULL_METRICS,
							)}
							cpuTrend={fleetExtras[server.name]?.cpuTrend ?? []}
							loadAvg={fleetExtras[server.name]?.loadAvg ?? null}
							netOutMbps={fleetExtras[server.name]?.netOutMbps ?? null}
						/>
					))}
				</div>
			) : (
				<LoadStateBanner state={serversState} upstreamLabel="Hetzner API error" />
			)
		}
	</section>

	<section class="rounded-xl border border-base-200 bg-white shadow-subtle">
		<header class="flex items-center justify-between border-b border-base-200 px-4 py-3.5">
			<span class="text-sm font-semibold text-base-900">
				Déploiements récents
			</span>
			<a
				href="/deployments"
				class="rounded-full px-3 py-1 text-xs font-medium text-base-700 hover:bg-base-50"
			>
				Voir tout
			</a>
		</header>
		{
			recentDeploys.length > 0 ? (
				<div class="flex flex-col">
					{recentDeploys.map((deploy) => (
						<a
							href={targetHref(deploy.target)}
							target={deploy.target.kind === 'external' ? '_blank' : undefined}
							rel={deploy.target.kind === 'external' ? 'noreferrer' : undefined}
							class="flex items-center gap-3 border-b border-base-100 px-4 py-3 last:border-b-0 hover:bg-base-50"
						>
							<span class:list={['shrink-0', DEPLOY_STATUS_COLOR[deploy.display]]}>
								<Icon name={DEPLOY_STATUS_ICON[deploy.display]} size={15} />
							</span>
							<div class="min-w-0 flex-1">
								<div class="truncate text-[13px] font-medium text-base-900">
									{deploy.title}
								</div>
								<div class="flex items-center gap-1.5 font-mono text-[11px] text-base-500">
									<Icon name="branch" size={11} />
									{deploy.branch} · {deploy.commit}
								</div>
							</div>
							<span class:list={['shrink-0', CONTEXT_PILL_CLASS]}>
								{deploy.contextLabel}
							</span>
							<span class:list={['shrink-0', SOURCE_PILL_CLASS]}>
								{SOURCE_PILL_LABEL[deploy.source]}
							</span>
							<span
								class:list={[
									'shrink-0 rounded-full border px-2 py-0.5 text-[11px] font-medium',
									ENV_PILL_CLASS[deploy.environment],
								]}
							>
								{ENV_PILL_LABEL[deploy.environment]}
							</span>
							<span class="shrink-0 font-mono text-[11px] text-base-500">
								{formatRelative(deploy.createdAtMs, nowMs)}
							</span>
						</a>
					))}
				</div>
			) : (
				<div class="p-4">
					<LoadStateBanner
						state={recentState}
						upstreamLabel="Cloudflare API error"
					/>
				</div>
			)
		}
	</section>
</div>
