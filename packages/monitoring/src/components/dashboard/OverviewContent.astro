---
import FleetCard from '@/components/dashboard/FleetCard.astro'
import Icon from '@/components/foundations/Icon.astro'
import type { IconName } from '@/components/foundations/Icon.astro'
import LoadStateBanner from '@/components/dashboard/LoadStateBanner.astro'
import OverviewStatCard from '@/components/dashboard/OverviewStatCard.astro'
import { ENV_KEYS, requireEnv } from '@/lib/adapters/env.ts'
import { listServers } from '@/lib/adapters/hetzner/servers.ts'
import { loadPageState } from '@/lib/adapters/load-page-state.ts'
import {
	loadHostMetrics,
	loadVpsGauges,
	loadVpsSeries,
} from '@/lib/adapters/victoria/metrics.ts'
import { loadFleetLogs } from '@/lib/adapters/victoria/logs.ts'
import { loadRecentDeployments } from '@/lib/adapters/cloudflare/recent-deployments.ts'
import {
	DEPLOY_STATUS_COLOR,
	DEPLOY_STATUS_ICON,
} from '@/components/cloudflare/deploy-display.ts'
import { deploymentDisplayStatus } from '@/lib/domain/cloudflare/deployment-summary.ts'
import {
	computeServerHealth,
	deriveFleetAlerts,
	summarizeFleet,
} from '@/lib/domain/monitoring/fleet-overview.ts'
import { formatRelative, formatTime } from '@/lib/domain/monitoring/format.ts'

import type { HostMetrics } from '@/lib/domain/monitoring/host-metrics.ts'
import type { LogLevel } from '@/lib/domain/monitoring/log-query.ts'

const LOG_STREAM_COUNT = 7
const SPARK_HOURS = 1
const DEPLOY_COUNT = 4
const COMMIT_LENGTH = 7

const NULL_METRICS: HostMetrics = {
	cpuPercent: null,
	memoryPercent: null,
	diskPercent: null,
	uptimeSeconds: null,
}

interface FleetExtra {
	cpuTrend: ReadonlyArray<number>
	loadAvg: number | null
	netOutMbps: number | null
}

const serversState = await loadPageState('overview.servers', () => {
	const token = requireEnv(ENV_KEYS.HETZNER_API_TOKEN)
	return listServers(token)
})
const servers = serversState.kind === 'ok' ? serversState.data : []

// The fleet metric pass, the logs query and the recent-deployments fan-out hit
// three independent upstreams, so kick them all off together and await once
// rather than serializing three round-trip waves. Within the fleet pass, all
// three queries per server fire together and every server fires together.
const fleetLoadsPromise = Promise.all(
	servers.map(async (server) => {
		const [metricsState, gaugesState, sparkState] = await Promise.all([
			loadPageState(`overview.metrics.${server.name}`, () =>
				loadHostMetrics(server.name),
			),
			loadPageState(`overview.gauges.${server.name}`, () =>
				loadVpsGauges(server.name),
			),
			loadPageState(`overview.spark.${server.name}`, () =>
				loadVpsSeries(server.name, 'cpu', SPARK_HOURS),
			),
		])
		return { name: server.name, metricsState, gaugesState, sparkState }
	}),
)
const logsStatePromise = loadPageState('overview.logs', loadFleetLogs)
const recentStatePromise = loadPageState('overview.deployments', () =>
	loadRecentDeployments(DEPLOY_COUNT),
)
const [fleetLoads, logsState, recentState] = await Promise.all([
	fleetLoadsPromise,
	logsStatePromise,
	recentStatePromise,
])

const metricsByName: Record<string, HostMetrics> = {}
const fleetExtras: Record<string, FleetExtra> = {}
for (const load of fleetLoads) {
	metricsByName[load.name] =
		load.metricsState.kind === 'ok' ? load.metricsState.data : NULL_METRICS
	const gauges =
		load.gaugesState.kind === 'ok' ? load.gaugesState.data : null
	const points = load.sparkState.kind === 'ok' ? load.sparkState.data : []
	fleetExtras[load.name] = {
		cpuTrend: points.map((point) => point.v),
		loadAvg: gauges?.load1 ?? null,
		netOutMbps: gauges?.netOutMbps ?? null,
	}
}

const logs = logsState.kind === 'ok' ? logsState.data : []
const errorCount = logs.filter((line) => line.level === 'error').length

const stats = summarizeFleet({ servers, metricsByName, errorCount })
const alerts = deriveFleetAlerts(servers, metricsByName)
const statIcons: IconName[] = ['server', 'cpu', 'net', 'alert']

const levelClass: Record<LogLevel, string> = {
	debug: 'text-base-400',
	info: 'text-sky-600',
	warn: 'text-amber-600',
	error: 'text-red-600',
}

const stream = logs.slice(0, LOG_STREAM_COUNT).map((line) => ({
	time: formatTime(new Date(line.time).getTime()),
	level: line.level,
	service: line.service,
	message: line.message,
}))

const nowMs = Date.now()
const recentDeploys = (recentState.kind === 'ok' ? recentState.data : []).map(
	(entry) => ({
		href: `/deployments?project=${encodeURIComponent(entry.projectName)}&sel=${encodeURIComponent(entry.deployment.id)}`,
		display: deploymentDisplayStatus(entry.deployment.status),
		message: entry.deployment.commitMessage ?? '(sans message)',
		branch: entry.deployment.branch ?? '-',
		commit:
			entry.deployment.commitHash?.slice(0, COMMIT_LENGTH) ??
			entry.deployment.shortId,
		isProd: entry.deployment.environment === 'production',
		ago: formatRelative(Date.parse(entry.deployment.createdAt), nowMs),
	}),
)
---

<div class="mx-auto flex max-w-[1320px] flex-col gap-5 p-6">
	<div
		class="grid grid-cols-[repeat(auto-fit,minmax(190px,1fr))] gap-3.5"
	>
		{
			stats.map((stat, index) => (
				<OverviewStatCard
					icon={statIcons[index] ?? 'activity'}
					label={stat.label}
					value={stat.value}
					hint={stat.hint}
					tone={stat.tone}
				/>
			))
		}
	</div>

	{
		alerts.length > 0 && (
			<section class="overflow-hidden rounded-xl border border-base-200 bg-white shadow-subtle">
				<header class="flex items-center justify-between border-b border-base-200 px-4 py-3.5">
					<div class="flex items-center gap-2.5">
						<span class="text-sm font-semibold text-base-900">Alertes actives</span>
						<span class="inline-flex items-center gap-1.5 rounded-full border border-red-200 bg-red-50 px-2 py-0.5 text-[11px] font-medium text-red-700">
							<span class="size-1.5 rounded-full bg-red-600" />
							{alerts.length}
						</span>
					</div>
				</header>
				{alerts.map((alert) => (
					<div class="flex items-center gap-3.5 border-b border-base-100 px-4 py-3 last:border-b-0">
						<span
							class:list={[
								'shrink-0',
								alert.severity === 'critical' ? 'text-red-600' : 'text-amber-500',
							]}
						>
							<Icon name="alert" size={18} />
						</span>
						<div class="min-w-0 flex-1">
							<div class="flex items-center gap-2">
								<span class="text-[13.5px] font-semibold text-base-900">
									{alert.label}
								</span>
								<span
									class:list={[
										'rounded-full border px-2 py-0.5 text-[11px] font-medium',
										alert.severity === 'critical'
											? 'border-red-200 bg-red-50 text-red-700'
											: 'border-amber-200 bg-amber-50 text-amber-700',
									]}
								>
									{alert.severity}
								</span>
								<span class="rounded-full border border-base-200 bg-base-100 px-2 py-0.5 font-mono text-[11px] text-base-700">
									{alert.vpsName}
								</span>
							</div>
						</div>
						<div class="shrink-0 text-right">
							<div
								class:list={[
									'font-mono text-sm font-bold',
									alert.severity === 'critical' ? 'text-red-600' : 'text-amber-600',
								]}
							>
								{alert.valuePercent}%
							</div>
							<div class="font-mono text-[10.5px] text-base-500">
								seuil {alert.thresholdPercent}%
							</div>
						</div>
						<a
							href={`/vps/${alert.vpsName}`}
							class="shrink-0 rounded-full bg-base-50 px-3 py-1 text-xs font-medium text-base-800 hover:bg-base-100"
						>
							Voir
						</a>
					</div>
				))}
			</section>
		)
	}

	<section>
		<div class="mb-3 flex items-center justify-between">
			<span
				class="inline-flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-base-700"
			>
				<span class="size-2.5 rounded-[2px] bg-base-900"></span>
				Fleet Hetzner
			</span>
			<span class="text-xs text-base-500">
				Cliquez un nœud pour les métriques détaillées
			</span>
		</div>
		{
			servers.length > 0 ? (
				<div class="grid grid-cols-[repeat(auto-fill,minmax(290px,1fr))] gap-3.5">
					{servers.map((server) => (
						<FleetCard
							server={server}
							metrics={metricsByName[server.name] ?? NULL_METRICS}
							health={computeServerHealth(
								server.status,
								metricsByName[server.name] ?? NULL_METRICS,
							)}
							cpuTrend={fleetExtras[server.name]?.cpuTrend ?? []}
							loadAvg={fleetExtras[server.name]?.loadAvg ?? null}
							netOutMbps={fleetExtras[server.name]?.netOutMbps ?? null}
						/>
					))}
				</div>
			) : (
				<LoadStateBanner state={serversState} upstreamLabel="Hetzner API error" />
			)
		}
	</section>

	<section class="grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-4">
		<div class="flex min-w-0 flex-col rounded-xl border border-base-200 bg-white shadow-subtle">
			<header class="flex items-center justify-between border-b border-base-200 px-4 py-3.5">
				<span class="text-sm font-semibold text-base-900">
					Déploiements récents
				</span>
				<a
					href="/deployments"
					class="rounded-full px-3 py-1 text-xs font-medium text-base-700 hover:bg-base-50"
				>
					Voir tout
				</a>
			</header>
			{
				recentDeploys.length > 0 ? (
					<div class="flex flex-col">
						{recentDeploys.map((deploy) => (
							<a
								href={deploy.href}
								class="flex items-center gap-3 border-b border-base-100 px-4 py-3 last:border-b-0 hover:bg-base-50"
							>
								<span class:list={['shrink-0', DEPLOY_STATUS_COLOR[deploy.display]]}>
									<Icon name={DEPLOY_STATUS_ICON[deploy.display]} size={15} />
								</span>
								<div class="min-w-0 flex-1">
									<div class="truncate text-[13px] font-medium text-base-900">
										{deploy.message}
									</div>
									<div class="flex items-center gap-1.5 font-mono text-[11px] text-base-500">
										<Icon name="branch" size={11} />
										{deploy.branch} · {deploy.commit}
									</div>
								</div>
								<span
									class:list={[
										'shrink-0 rounded-full border px-2 py-0.5 text-[10.5px] font-medium',
										deploy.isProd
											? 'border-accent-200 bg-accent-50 text-accent-800'
											: 'border-base-200 bg-base-100 text-base-600',
									]}
								>
									{deploy.isProd ? 'prod' : 'preview'}
								</span>
								<span class="shrink-0 font-mono text-[11px] text-base-500">
									{deploy.ago}
								</span>
							</a>
						))}
					</div>
				) : (
					<div class="p-4">
						<LoadStateBanner
							state={recentState}
							upstreamLabel="Cloudflare API error"
						/>
					</div>
				)
			}
		</div>

		<div class="flex min-w-0 flex-col rounded-xl border border-base-200 bg-white shadow-subtle">
			<header class="flex items-center justify-between border-b border-base-200 px-4 py-3.5">
				<span class="text-sm font-semibold text-base-900">Flux de logs</span>
				<a
					href="/logs"
					class="rounded-full px-3 py-1 text-xs font-medium text-base-700 hover:bg-base-50"
				>
					Explorer
				</a>
			</header>
			{
				stream.length > 0 ? (
					<div class="flex flex-col py-2 font-mono text-[11.5px]">
						{stream.map((line) => (
							<a
								href="/logs"
								class="flex gap-2 overflow-hidden rounded px-3 py-1 whitespace-nowrap hover:bg-base-50"
							>
								<span class="text-base-400">{line.time}</span>
								<span
									class:list={[
										'w-10 shrink-0 text-[10.5px] font-semibold uppercase',
										line.level === null ? 'text-base-400' : levelClass[line.level],
									]}
								>
									{line.level ?? '·'}
								</span>
								<span class="shrink-0 text-base-500">{line.service ?? ''}</span>
								<span class="overflow-hidden text-ellipsis text-base-800">
									{line.message}
								</span>
							</a>
						))}
					</div>
				) : (
					<div class="p-4">
						<LoadStateBanner state={logsState} upstreamLabel="VictoriaLogs error" />
					</div>
				)
			}
		</div>
	</section>
</div>
