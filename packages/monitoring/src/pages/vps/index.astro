---
import LoadStateBanner from '@/components/dashboard/LoadStateBanner.astro'
import {
	FLEET_PRESENCE_DOT,
	fleetPresence,
} from '@/components/vps/fleet-status-display.ts'
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { loadPageState } from '@/lib/adapters/load-page-state.ts'
import { listFleetVps } from '@/lib/adapters/victoria/fleet.ts'

// oxlint-disable-next-line nextnode/boolean-naming -- prerender is Astro's required route export name
export const prerender = false

const fleetState = await loadPageState('vps.fleet', () => listFleetVps())
const servers = fleetState.kind === 'ok' ? fleetState.data : []
---

<DashboardLayout title="VPS" breadcrumbs={[{ label: 'VPS' }]}>
	<div class="flex flex-col gap-5">
		{
			servers.length > 0 ? (
				<div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-3.5">
					{servers.map((server) => (
						<a
							href={`/vps/${server.name}`}
							class="block overflow-hidden rounded-xl border border-base-200 bg-white p-4 shadow-subtle transition-shadow hover:shadow-navy"
						>
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0">
									<div class="flex items-center gap-2">
										<span
											class:list={[
												'inline-block size-2 rounded-full',
												FLEET_PRESENCE_DOT[fleetPresence(server.isOnline)],
											]}
										/>
										<span class="truncate font-mono text-sm font-bold text-base-900">
											{server.name}
										</span>
									</div>
									<p class="mt-1 truncate text-xs text-base-500">
										{server.project ?? 'aucun projet'}
									</p>
								</div>
								<span class="shrink-0 rounded-full border border-base-200 bg-base-100 px-2 py-0.5 text-[11px] font-medium text-base-700">
									{fleetPresence(server.isOnline)}
								</span>
							</div>
						</a>
					))}
				</div>
			) : (
				<LoadStateBanner state={fleetState} upstreamLabel="VictoriaMetrics error" />
			)
		}
	</div>
</DashboardLayout>
