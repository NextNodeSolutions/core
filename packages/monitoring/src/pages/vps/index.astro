---
import Icon from '@/components/foundations/Icon.astro'
import LoadStateBanner from '@/components/dashboard/LoadStateBanner.astro'
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { ENV_KEYS, requireEnv } from '@/lib/adapters/env.ts'
import { listServers } from '@/lib/adapters/hetzner/servers.ts'
import { loadPageState } from '@/lib/adapters/load-page-state.ts'

// oxlint-disable-next-line nextnode/boolean-naming -- prerender is Astro's required route export name
export const prerender = false

const fleetState = await loadPageState('vps.fleet', () => {
	const token = requireEnv(ENV_KEYS.HETZNER_API_TOKEN)
	return listServers(token)
})
const servers = fleetState.kind === 'ok' ? fleetState.data : []

const statusDot: Record<string, string> = {
	running: 'bg-accent-600',
	off: 'bg-base-400',
	deleting: 'bg-base-400',
}
---

<DashboardLayout title="VPS" bare breadcrumbs={[{ label: 'VPS' }]}>
	<div class="mx-auto flex max-w-[1320px] flex-col gap-5 p-6">
		{
			servers.length > 0 ? (
				<div class="grid grid-cols-[repeat(auto-fill,minmax(290px,1fr))] gap-3.5">
					{servers.map((server) => (
						<a
							href={`/vps/${server.name}`}
							class="block overflow-hidden rounded-xl border border-base-200 bg-white p-4 shadow-subtle transition-shadow hover:shadow-navy"
						>
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0">
									<div class="flex items-center gap-2">
										<span
											class:list={[
												'inline-block size-2 rounded-full',
												statusDot[server.status] ?? 'bg-amber-500',
											]}
										/>
										<span class="truncate font-mono text-sm font-bold text-base-900">
											{server.name}
										</span>
									</div>
									<p class="mt-1 truncate text-xs text-base-500">
										{server.serverType.name}
									</p>
								</div>
								<span class="shrink-0 rounded-full border border-base-200 bg-base-100 px-2 py-0.5 text-[11px] font-medium text-base-700">
									{server.status}
								</span>
							</div>
							<p class="mt-3 flex items-center gap-1 font-mono text-[10.5px] text-base-500">
								<Icon name="location" size={11} />
								{server.location.city ?? server.location.name}
							</p>
						</a>
					))}
				</div>
			) : (
				<LoadStateBanner state={fleetState} upstreamLabel="Hetzner API error" />
			)
		}
	</div>
</DashboardLayout>
