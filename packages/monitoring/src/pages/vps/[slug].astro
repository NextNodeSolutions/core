---
import Icon from '@/components/foundations/Icon.astro'
import LoadStateBanner from '@/components/dashboard/LoadStateBanner.astro'
import RangeControl from '@/components/layout/RangeControl.astro'
import Skeleton from '@/components/dashboard/Skeleton.astro'
import VpsMetrics from '@/components/vps/VpsMetrics.astro'
import {
	FLEET_PRESENCE_BADGE,
	FLEET_PRESENCE_DOT,
	fleetPresence,
} from '@/components/vps/fleet-status-display.ts'
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { loadPageState } from '@/lib/adapters/load-page-state.ts'
import {
	getFleetVpsByName,
	loadHostFacts,
} from '@/lib/adapters/victoria/fleet.ts'
import { resolveEntityState } from '@/lib/domain/load-state.ts'
import {
	bytesToWholeDecimalGb,
	bytesToWholeGb,
	NULL_HOST_FACTS,
} from '@/lib/domain/monitoring/host-facts.ts'

// oxlint-disable-next-line nextnode/boolean-naming -- prerender is Astro's required route export name
export const prerender = false

const FALLBACK_ROWS = 5

const { slug } = Astro.params
if (!slug) {
	return Astro.redirect('/vps')
}

const range = Astro.url.searchParams.get('range') ?? 'live'

const [headerState, factsState] = await Promise.all([
	loadPageState(`vps.${slug}.header`, () => getFleetVpsByName(slug)),
	loadPageState(`vps.${slug}.facts`, () => loadHostFacts(slug)),
])
// Classify the lookup once: a found VPS, a clean not-found (unknown slug),
// or a genuine load failure. The island reuses this resolved `vps` for its
// header data; its own fleet query (peer comparison) hits the adapter's 30s
// discovery cache instead of a fresh upstream query.
const outcome = resolveEntityState(headerState)
const vps = outcome.status === 'present' ? outcome.data : null
const facts = factsState.kind === 'ok' ? factsState.data : NULL_HOST_FACTS

const presence = fleetPresence(vps?.isOnline ?? false)
const memoryGb = bytesToWholeGb(facts.memoryTotalBytes)
const diskGb = bytesToWholeDecimalGb(facts.diskTotalBytes)
---

<DashboardLayout
	title={slug}
	breadcrumbs={[{ label: 'VPS', href: '/vps' }, { label: slug }]}
>
	<RangeControl slot="actions" path={`/vps/${slug}`} value={range} />

	{
		vps && (
			<div class="flex flex-col gap-[18px]">
				<div class="overflow-hidden rounded-xl border border-base-200 bg-white shadow-subtle">
					<div class="flex flex-wrap items-start justify-between gap-4 px-5 py-4.5">
						<div class="min-w-0">
							<div class="flex flex-wrap items-center gap-2.5">
								<span
									class:list={[
										'inline-block size-2.5 rounded-full',
										FLEET_PRESENCE_DOT[presence],
									]}
								/>
								<h2 class="font-mono text-[22px] font-bold tracking-[-0.02em] whitespace-nowrap text-base-900">
									{vps.name}
								</h2>
								<span
									class:list={[
										'rounded-full border px-2 py-0.5 text-[11px] font-medium',
										FLEET_PRESENCE_BADGE[presence],
									]}
								>
									{presence}
								</span>
							</div>
							<p class="mt-1.5 text-[13px] text-base-500">
								{vps.project ?? 'aucun projet'}
							</p>
						</div>
						<div class="flex gap-2">
							<a
								href="/logs"
								class="inline-flex items-center gap-1.5 rounded-full bg-base-50 px-3.5 py-1.5 text-xs font-medium text-base-800 hover:bg-base-100"
							>
								<Icon name="logs" size={14} />
								Logs
							</a>
						</div>
					</div>
					<div class="grid grid-cols-[repeat(auto-fit,minmax(120px,1fr))] gap-4 border-t border-base-100 bg-base-50 px-5 py-3.5">
						<div>
							<div class="text-[10.5px] tracking-[0.04em] text-base-500 uppercase">
								vCPU
							</div>
							<div class="mt-0.5 font-mono text-[13px] font-semibold text-base-900">
								{facts.cores === null ? '-' : `${facts.cores} cores`}
							</div>
						</div>
						<div>
							<div class="text-[10.5px] tracking-[0.04em] text-base-500 uppercase">
								RAM
							</div>
							<div class="mt-0.5 font-mono text-[13px] font-semibold text-base-900">
								{memoryGb === null ? '-' : `${memoryGb} GB`}
							</div>
						</div>
						<div>
							<div class="text-[10.5px] tracking-[0.04em] text-base-500 uppercase">
								Disque
							</div>
							<div class="mt-0.5 font-mono text-[13px] font-semibold text-base-900">
								{diskGb === null ? '-' : `${diskGb} GB`}
							</div>
						</div>
						<div>
							<div class="text-[10.5px] tracking-[0.04em] text-base-500 uppercase">
								Projet
							</div>
							<div class="mt-0.5 font-mono text-[13px] font-semibold text-base-900">
								{vps.project ?? '-'}
							</div>
						</div>
					</div>
				</div>

				<VpsMetrics
					server:defer
					slug={slug}
					vps={vps}
					facts={facts}
					range={range}
				>
					<Skeleton slot="fallback" rows={FALLBACK_ROWS} />
				</VpsMetrics>
			</div>
		)
	}

	{
		outcome.status === 'not_found' && (
			<div>
				<div class="rounded-2xl border border-amber-200 bg-amber-50 p-6 text-amber-900">
					<p class="font-display text-base font-semibold">VPS introuvable</p>
					<p class="mt-1 font-mono text-xs">
						Aucun VPS monitoré ne correspond au nom <code>{slug}</code>.
					</p>
				</div>
			</div>
		)
	}

	{
		outcome.status === 'failed' && (
			<div>
				<LoadStateBanner
					state={outcome.state}
					upstreamLabel="VictoriaMetrics error"
				/>
			</div>
		)
	}
</DashboardLayout>
