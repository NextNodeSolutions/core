---
import LoadStateBanner from '@/components/dashboard/LoadStateBanner.astro'
import { LogsExplorer } from '@/islands/logs/LogsExplorer.tsx'
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { loadPageState } from '@/lib/adapters/load-page-state.ts'
import {
	loadFleetLogs,
	loadFleetStats,
	loadLogFacets,
} from '@/lib/adapters/victoria/logs.ts'
import { EMPTY_FLEET_STATS } from '@/lib/domain/monitoring/log-aggregates.ts'
import { rangeToHours } from '@/lib/domain/monitoring/vps-metrics.ts'

import type { FleetLogStats } from '@/lib/domain/monitoring/log-aggregates.ts'
import type {
	LogFacets,
	LogLine,
} from '@/lib/domain/monitoring/log-query.ts'

// oxlint-disable-next-line nextnode/boolean-naming -- prerender is Astro's required route export name
export const prerender = false

const DEFAULT_RANGE = '6h'

const range = Astro.url.searchParams.get('range') ?? DEFAULT_RANGE

// First paint: load the initial range's log SAMPLE (the list) and its WINDOWED
// aggregates (histogram + counts) once on the server so the island hydrates
// fully with no loading flash. `rangeToHours` maps `live` to a short 5-min
// window. `nowMs` is the server clock injected into both the stats bucket grid
// and the island so the histogram lines up with the list's window.
const hours = rangeToHours(range)
const nowMs = Date.now()
// First paint has no facet selection yet, so the sample + stats load unfiltered;
// the facet value lists seed the dropdowns. Filtering kicks in on the client.
const [logsState, statsState, facetsState] = await Promise.all([
	loadPageState('logs.fleet', () => loadFleetLogs(hours)),
	loadPageState('logs.stats', () => loadFleetStats(hours, nowMs)),
	loadPageState('logs.facets', () => loadLogFacets(hours)),
])
const initialLogs: ReadonlyArray<LogLine> =
	logsState.kind === 'ok' ? logsState.data : []
const initialStats: FleetLogStats =
	statsState.kind === 'ok' ? statsState.data : EMPTY_FLEET_STATS
const initialFacets: LogFacets =
	facetsState.kind === 'ok' ? facetsState.data : { services: [], vps: [] }
const failedToLoad = logsState.kind !== 'ok'
---

<DashboardLayout title="Explorateur de logs" bare breadcrumbs={[{ label: 'Logs' }]}>
	{
		failedToLoad && (
			<div class="px-6 pt-3">
				<LoadStateBanner state={logsState} upstreamLabel="VictoriaLogs error" />
			</div>
		)
	}

	<LogsExplorer
		client:load
		initialLogs={initialLogs}
		initialStats={initialStats}
		initialFacets={initialFacets}
		initialRange={range}
	/>
</DashboardLayout>
