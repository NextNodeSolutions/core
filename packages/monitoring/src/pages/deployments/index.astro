---
import LoadStateBanner from '@/components/dashboard/LoadStateBanner.astro'
import { Deployments } from '@/islands/deployments/Deployments.tsx'
import DashboardLayout from '@/layouts/DashboardLayout.astro'
import { resolveCloudflareClient } from '@/lib/adapters/cloudflare/accounts.ts'
import { listPagesDeployments } from '@/lib/adapters/cloudflare/pages-deployments.ts'
import { listPagesProjects } from '@/lib/adapters/cloudflare/pages-projects.ts'
import { loadVpsDeployRuns } from '@/lib/adapters/github/vps-deployments.ts'
import { loadPageState } from '@/lib/adapters/load-page-state.ts'
import { mapWithConcurrency } from '@/lib/domain/concurrency.ts'

import type { DeploymentsSeed } from '@/islands/deployments/atoms.ts'
import type { CloudflareClient } from '@/lib/adapters/cloudflare/client.ts'
import type { CloudflarePagesDeployment } from '@/lib/domain/cloudflare/pages-deployment.ts'
import type { CloudflarePagesProject } from '@/lib/domain/cloudflare/pages-project.ts'
import type { VpsDeployRun } from '@/lib/domain/github/vps-deploy-run.ts'

// oxlint-disable-next-line nextnode/boolean-naming -- prerender is Astro's required route export name
export const prerender = false

const PER_PROJECT_LIMIT = 20
const PER_WORKFLOW_RUN_LIMIT = 10
const FAN_OUT_CONCURRENCY = 6
const DEFAULT_ENV = 'all'

const params = Astro.url.searchParams
const project = params.get('project') ?? ''
const env = params.get('env') ?? DEFAULT_ENV
const sel = params.get('sel') ?? ''

// Server fan-out: load every project + its deployments once, then hand the
// assembled set to the island as a seed. The island does ALL selection /
// filtering client-side from it - no refetch on an interaction. `nowMs` is
// computed server-side so relative times stay deterministic in render.
// The GitHub side of the feed (VPS deploy runs) is independent of the
// Cloudflare client, so it loads in parallel with the Pages fan-out. A GitHub
// failure degrades to an empty VPS list (logged by loadPageState) without
// blanking the Pages data, and vice versa.
const vpsRunsStatePromise = loadPageState('deployments.vpsRuns', () =>
	loadVpsDeployRuns(PER_WORKFLOW_RUN_LIMIT),
)

const clientState = await loadPageState(
	'deployments.client',
	resolveCloudflareClient,
)
const client = clientState.kind === 'ok' ? clientState.data : null

const loadProjects = async (
	resolved: CloudflareClient,
): Promise<ReadonlyArray<CloudflarePagesProject>> => {
	const state = await loadPageState('deployments.projects', () =>
		listPagesProjects({ client: resolved }),
	)
	return state.kind === 'ok' ? state.data : []
}

const projects: ReadonlyArray<CloudflarePagesProject> =
	client === null ? [] : await loadProjects(client)

const loadProjectDeployments = async (
	resolved: CloudflareClient | null,
): Promise<Record<string, ReadonlyArray<CloudflarePagesDeployment>>> => {
	if (resolved === null) return {}
	const states = await mapWithConcurrency(
		projects,
		FAN_OUT_CONCURRENCY,
		currentProject =>
			loadPageState(`deployments.deps.${currentProject.name}`, () =>
				listPagesDeployments({
					client: resolved,
					projectName: currentProject.name,
					limit: PER_PROJECT_LIMIT,
				}),
			),
	)
	const grouped: Record<string, ReadonlyArray<CloudflarePagesDeployment>> = {}
	projects.forEach((currentProject, index) => {
		const state = states[index]
		grouped[currentProject.name] =
			state && state.kind === 'ok' ? state.data : []
	})
	return grouped
}

const deploymentsByProject: Record<
	string,
	ReadonlyArray<CloudflarePagesDeployment>
> = await loadProjectDeployments(client)

const vpsRunsState = await vpsRunsStatePromise
const vpsRuns: ReadonlyArray<VpsDeployRun> =
	vpsRunsState.kind === 'ok' ? vpsRunsState.data : []

const seed: DeploymentsSeed = { projects, deploymentsByProject, vpsRuns }
const clientFailed = clientState.kind !== 'ok'
const nowMs = Date.now()
---

<DashboardLayout
	title="Déploiements"
	breadcrumbs={[{ label: 'Cloudflare Pages' }, { label: 'VPS' }]}
>
	{
		clientFailed ? (
			<LoadStateBanner
				state={clientState}
				upstreamLabel="Cloudflare API error"
			/>
		) : (
			<Deployments
				client:load
				data={seed}
				initialProject={project}
				initialEnv={env}
				initialSel={sel}
				nowMs={nowMs}
			/>
		)
	}
</DashboardLayout>
