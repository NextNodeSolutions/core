---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Sidebar from '@/components/layout/Sidebar.astro'
import Topbar from '@/components/layout/Topbar.astro'

import type { Breadcrumb } from '@/components/layout/Topbar.astro'

interface Props {
	title: string
	description?: string
	breadcrumbs?: Breadcrumb[]
	/** Design screens manage their own padding; set to render edge-to-edge. */
	bare?: boolean
	vpsCount?: number
	alertCount?: number
}

const {
	title,
	description,
	breadcrumbs = [],
	bare = false,
	vpsCount,
	alertCount,
} = Astro.props
const currentPath = Astro.url.pathname
---

<BaseLayout title={title} description={description}>
	<div class="flex min-h-svh">
		<Sidebar current={currentPath} vpsCount={vpsCount} alertCount={alertCount} />

		<div class="flex min-w-0 flex-1 flex-col">
			<Topbar title={title} crumbs={breadcrumbs}>
				<slot name="actions" slot="actions" />
			</Topbar>

			<main class="min-h-0 flex-1 bg-base-50">
				{
					bare ? (
						<slot />
					) : (
						<div class="mx-auto max-w-6xl px-8 py-10">
							<slot />
						</div>
					)
				}
			</main>
		</div>
	</div>
</BaseLayout>
